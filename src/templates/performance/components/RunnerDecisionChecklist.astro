---
import { registerClickAttributes } from '../../../shared/analytics/register-click.mjs';
const { race } = Astro.props;
const checklist = race.runner_decision_checklist;
const items = Array.isArray(checklist?.items) ? checklist.items.filter((item) => item?.label && item?.value) : [];
const registerUrl = race.registration?.url || '#entry';
const configuredGroups = Array.isArray(checklist?.groups) ? checklist.groups : [];
const defaultGroups = [
  {
    label: 'Race Basics',
    intro: 'Date, distance, start time, and location.',
    itemIds: ['date', 'distance', 'start-time', 'location']
  },
  {
    label: 'Course & Credentials',
    intro: 'Certification, course profile, support, and time-limit proof without repeating the same facts later.',
    itemIds: ['course', 'aid-stations', 'time-limit', 'awards']
  },
  {
    label: 'Before You Register',
    intro: 'Price, packet pick-up, policies, and participant items before runners continue to official registration.',
    itemIds: ['price', 'packet-pickup', 'refunds-transfers', 'swag']
  }
];
const sourceGroups = configuredGroups.length ? configuredGroups : defaultGroups;
const groups = sourceGroups.map((group) => ({
  ...group,
  items: group.itemIds.map((id) => items.find((item) => item.id === id)).filter(Boolean)
})).filter((group) => group.items.length);
const groupedIds = new Set(groups.flatMap((group) => group.items.map((item) => item.id)));
const remainingItems = items.filter((item) => !groupedIds.has(item.id));
if (remainingItems.length && !configuredGroups.length) {
  groups.push({
    label: 'Additional race details',
    intro: 'Other useful details available before runners continue to official registration.',
    items: remainingItems
  });
}
const showFooterCta = checklist?.footer_cta !== false;
const kicker = checklist?.kicker || 'Race details';
---
{items.length ? (
  <section class="perf-runner-checklist" id="runner-checklist" data-runner-decision-checklist>
    <div class="wrap perf-private-wrap">
      <div class="perf-private-head reveal">
        <div>
          <div class="kicker">{kicker}</div>
          <h2 class="sec-title">{checklist?.headline || 'Everything runners need for race day.'}</h2>
          <p class="lead">{checklist?.intro || 'Start times, course details, packet pickup, participant perks, and official race status in one place.'}</p>
        </div>
      </div>
      <div class="perf-info-hub-grid stagger" aria-label="Runner information hub">
        {groups.map((group) => (
          <article class="perf-info-hub-group">
            <div class="perf-info-hub-group-head">
              <span>{group.label}</span>
              <p>{group.intro}</p>
            </div>
            <div class="perf-info-hub-list">
              {group.items.map((item) => (
                <div class="perf-info-hub-row" data-checklist-item-id={item.id}>
                  <span>{item.label}</span>
                  <strong>{item.value}</strong>
                  {item.detail ? <p>{item.detail}</p> : null}
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>
      {showFooterCta ? (
        <div class="perf-check-footer reveal">
          <p>Checked the basics? Continue when the price, course, and race-day details fit your goal.</p>
          <a class="btn btn-yellow" href={registerUrl} target="_blank" rel="noopener" {...registerClickAttributes(race, 'runner-checklist-footer')}>Continue to official registration</a>
        </div>
      ) : null}
    </div>
  </section>
) : null}

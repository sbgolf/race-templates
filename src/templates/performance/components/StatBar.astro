---
const { race } = Astro.props;
---
<div class="statbar">
  <div class="statbar-grid stagger">
    <div class="stat"><div class="n">22<span class="acc">%</span></div><div class="l">2025 BQ Rate</div><div class="sub">Of 4,200 finishers</div></div>
    <div class="stat"><div class="n">4,200</div><div class="l">Field Cap</div><div class="sub">Sold out 4 years running</div></div>
    <div class="stat"><div class="n">2:11:24</div><div class="l">Course Record</div><div class="sub">Set 2025 · Tadesse Yemane</div></div>
    <div class="stat"><div class="n">−12 <span style="font-size:.6em;letter-spacing:.04em">FT</span></div><div class="l">Net Elevation</div><div class="sub">Point-to-point downhill</div></div>
  </div>
</div>

---
const { race } = Astro.props;
const proof = race.proof || {};
const records = Array.isArray(race.records) ? race.records : [];
const certification = race.course?.certification || race.distances?.[0]?.certification;
const hasBqProof = proof.bq_rate || proof.bq_finishers;
const hasRecords = records.length > 0;
const showSection = hasBqProof || hasRecords || certification;
---
{showSection && (
  <section class="records" id="records">
    <div class="wrap">
      <div class="reveal">
        <div class="kicker">{hasBqProof ? 'Boston Qualifier & Records' : 'Certification & Speed Proof'}</div>
        <h2 class="sec-title">A race for <em>the chase</em>.</h2>
        <p class="lead">{race.performance?.records_lead || race.course?.records_note || 'Course facts are surfaced for runners comparing fast, certified race options.'}</p>
      </div>

      <div class="records-grid">
        {hasBqProof && (
          <div class="rec-card dark reveal">
            <div class="rh">Boston Qualifier Rate</div>
            <h3>{proof.bq_rate}% qualified.</h3>
            <p class="desc">{proof.bq_finishers && proof.field_cap ? `With a field cap of ${Number(proof.field_cap).toLocaleString('en-US')}, ${proof.bq_finishers} runners ran a time below their Boston qualifying standard.` : 'Boston qualifier proof is ready when race results support it.'}</p>
            {proof.bq_finishers && <div class="bq-hero"><div class="v">{proof.bq_finishers}{proof.field_cap && <small>/{proof.field_cap}</small>}</div><div class="l">BQ Finishers</div></div>}
            <div class="rec-foot">Standards per Boston Athletic Association · Subject to BAA updates</div>
          </div>
        )}

        {hasRecords && (
          <div class="rec-card reveal">
            <div class="rh">Course Record Book</div>
            <h3>Hall of fast.</h3>
            <p class="desc">{race.performance?.record_book_intro || 'Configured course-record history for this race.'}</p>
            <div class="ri-row head"><div>Year</div><div>Men's</div><div>Women's</div></div>
            {records.map((record) => <div class="ri-row"><div class="ri-l">{record.year}</div><div class="ri-v gold">{record.mens_time}</div><div class="ri-v gold">{record.womens_time}</div></div>)}
            <div class="rec-foot">All marks subject to official race verification</div>
          </div>
        )}

        {!hasBqProof && !hasRecords && certification && (
          <div class="rec-card dark reveal">
            <div class="rh">Certified Course</div>
            <h3>{certification.replace(/^USATF certified\s*/i, '')}</h3>
            <p class="desc">{race.course?.description || race.distances?.[0]?.profile || 'The race distance includes certification details runners can verify before registering.'}</p>
            <div class="rec-foot">Certification details are presented clearly for runner trust.</div>
          </div>
        )}
      </div>
    </div>
  </section>
)}

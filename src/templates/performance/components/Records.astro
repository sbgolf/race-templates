---
const { race } = Astro.props;
---
<section class="records" id="records">
  <div class="wrap">
    <div class="reveal">
      <div class="kicker">Boston Qualifier &amp; Records</div>
      <h2 class="sec-title">A race for <em>the chase</em>.</h2>
      <p class="lead">Capital sits on the Boston-qualifier short list for a reason — the course is built to deliver the time you trained for, and a fifth of our field walks away with the ticket.</p>
    </div>

    <div class="records-grid">
      <div class="rec-card dark reveal">
        <div class="rh">2025 Boston Qualifier Rate</div>
        <h3>22% qualified.</h3>
        <p class="desc">Of 4,200 finishers, 924 ran a time below their Boston qualifying standard. We're top-5 nationally for fastest legal-finish ratio.</p>
        <div class="bq-hero">
          <div class="v">924<small>/4,200</small></div>
          <div class="l">2025 BQ Finishers</div>
        </div>
        <div class="ri-row head"><div>Age Group</div><div>Men's Standard</div><div>Women's Standard</div></div>
        <div class="ri-row"><div class="ri-l">18–34</div><div class="ri-v">3:00:00</div><div class="ri-v">3:30:00</div></div>
        <div class="ri-row"><div class="ri-l">35–39</div><div class="ri-v">3:05:00</div><div class="ri-v">3:35:00</div></div>
        <div class="ri-row"><div class="ri-l">40–44</div><div class="ri-v">3:10:00</div><div class="ri-v">3:40:00</div></div>
        <div class="ri-row"><div class="ri-l">45–49</div><div class="ri-v">3:20:00</div><div class="ri-v">3:50:00</div></div>
        <div class="ri-row"><div class="ri-l">50–54</div><div class="ri-v">3:25:00</div><div class="ri-v">3:55:00</div></div>
        <div class="ri-row"><div class="ri-l">55–59</div><div class="ri-v">3:35:00</div><div class="ri-v">4:05:00</div></div>
        <div class="rec-foot">Standards per Boston Athletic Association · Subject to BAA updates</div>
      </div>

      <div class="rec-card reveal">
        <div class="rh">Course Record Book</div>
        <h3>Hall of fast.</h3>
        <p class="desc">Five years of Capital winners. The course has gotten faster every year as the pacing depth has grown.</p>
        <div class="ri-row head"><div>Year</div><div>Men's CR</div><div>Women's CR</div></div>
        <div class="ri-row"><div class="ri-l">2025</div><div class="ri-v gold">2:11:24</div><div class="ri-v gold">2:28:50</div></div>
        <div class="ri-row"><div class="ri-l">2024</div><div class="ri-v">2:12:08</div><div class="ri-v">2:30:14</div></div>
        <div class="ri-row"><div class="ri-l">2023</div><div class="ri-v">2:13:42</div><div class="ri-v">2:31:22</div></div>
        <div class="ri-row"><div class="ri-l">2022</div><div class="ri-v">2:15:09</div><div class="ri-v">2:33:01</div></div>
        <div class="ri-row"><div class="ri-l">2021</div><div class="ri-v">2:16:30</div><div class="ri-v">2:34:48</div></div>
        <div class="rec-foot">All marks USATF certified · Subject to ratification</div>
      </div>
    </div>
  </div>
</section>

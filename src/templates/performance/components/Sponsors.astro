---
const { race } = Astro.props;
const sponsors = Array.isArray(race.sponsors) ? race.sponsors.filter((sponsor) => sponsor?.name || typeof sponsor === 'string') : [];
---
{sponsors.length > 0 && (
  <div class="sponsors">
    <div class="wrap">
      <p class="sp-lab">Partners &amp; Sponsors</p>
      <div class="sp-row">
        {sponsors.map((sponsor) => <span>{typeof sponsor === 'string' ? sponsor : sponsor.name}</span>)}
      </div>
    </div>
  </div>
)}

---
const { race } = Astro.props;
const primaryDistance = race.distances?.find((distance) => distance.featured) || race.distances?.[0] || {};
const course = race.course || {};
const certification = course.certification || primaryDistance.certification;
const totalDistance = primaryDistance.distance || (course.distance_miles ? `${course.distance_miles} mi` : '');
const title = course.title || 'Built for the clock.';
const lead = course.description || primaryDistance.profile || race.story?.paragraphs?.find((paragraph) => /course|certified|flat|fast/i.test(paragraph)) || 'Course details are organized around the facts runners check before they register.';
const rows = [
  totalDistance && { label: 'Total Distance', value: totalDistance },
  course.net_elevation !== undefined && { label: 'Net Elevation', value: `${course.net_elevation} FT`, className: Number(course.net_elevation) <= 0 ? 'green' : '' },
  course.max_climb?.feet && { label: 'Max Climb', value: `${course.max_climb.feet} FT${course.max_climb.mile ? ` · MILE ${course.max_climb.mile}` : ''}` },
  certification && { label: 'USATF Cert', value: certification.replace(/^USATF certified\s*/i, ''), className: 'acc' },
  course.type && { label: 'Course Type', value: course.type },
  primaryDistance.cutoff && { label: 'Cutoff Time', value: primaryDistance.cutoff },
  primaryDistance.aid_stations && { label: 'Aid Stations', value: `${primaryDistance.aid_stations} listed`, className: 'acc' },
  course.eligible_records && { label: 'Record Eligible', value: course.eligible_records }
].filter(Boolean);
const profile = Array.isArray(course.elevation_profile) ? course.elevation_profile : [];
const hasProfile = profile.length >= 2;
const minFeet = hasProfile ? Math.min(...profile.map((point) => Number(point.feet))) : 0;
const maxFeet = hasProfile ? Math.max(...profile.map((point) => Number(point.feet))) : 0;
const maxMile = hasProfile ? Math.max(...profile.map((point) => Number(point.mile))) : Number(primaryDistance.distance_miles || course.distance_miles || 13.1);
const spread = Math.max(1, maxFeet - minFeet);
const points = hasProfile ? profile.map((point) => {
  const x = (Number(point.mile) / maxMile) * 500;
  const y = 170 - ((Number(point.feet) - minFeet) / spread) * 120;
  return `${x.toFixed(1)},${y.toFixed(1)}`;
}).join(' ') : '';
const fillPoints = hasProfile ? `0,200 ${points} 500,200` : '';
const formatFeet = (feet) => `${Math.round(Number(feet))} ft`;
const midFeet = hasProfile ? minFeet + (spread / 2) : 0;
const elevationTicks = hasProfile ? [
  { label: formatFeet(maxFeet), position: 20 },
  { label: formatFeet(midFeet), position: 50 },
  { label: formatFeet(minFeet), position: 80 }
] : [];
const detailRows = rows;
---
<section class="course" id="course">
  <div class="wrap">
    <div class="reveal">
      <div class="kicker">The Course</div>
      <h2 class="sec-title">{title}</h2>
      <p class="lead">{lead}</p>
    </div>

    <div class:list={["course-grid", { "course-grid--details-only": !hasProfile }]}>
      {hasProfile && (
        <div class="course-viz reveal" data-performance-elevation-profile>
          <div class="course-viz-head">
            <span>ELEVATION PROFILE</span>
            {certification && <span class="net">{certification.replace(/^USATF certified\s*/i, '')}</span>}
          </div>
          <div class="profile-chart profile-chart--with-axis">
            <div class="profile-y-axis" aria-hidden="true">
              {elevationTicks.map((tick) => <span style={`top:${tick.position}%`}>{tick.label}</span>)}
            </div>
            <svg viewBox="0 0 500 200" preserveAspectRatio="none" aria-label={`Elevation profile from ${formatFeet(minFeet)} to ${formatFeet(maxFeet)}`} role="img">
              <line x1="0" y1="100" x2="500" y2="100" stroke="rgba(10,10,18,.08)" stroke-dasharray="4 4"/>
              <polyline points={points} fill="none" stroke="#2D5BFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <polygon points={fillPoints} fill="rgba(45,91,255,.12)"/>
            </svg>
          </div>
          <div class="profile-mile">
            <span>0 mi</span><span>{maxMile / 2}</span><span>{maxMile} mi</span>
          </div>
        </div>
      )}

      {detailRows.length > 0 && (
        <div class="course-info reveal">
          {detailRows.map((row) => <div class="ci-row"><span class="l">{row.label}</span><span class={`v ${row.className || ''}`}>{row.value}</span></div>)}
        </div>
      )}
    </div>
  </div>
</section>

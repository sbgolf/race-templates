---
const { race } = Astro.props;
---
<section class="course" id="course">
  <div class="wrap">
    <div class="reveal">
      <div class="kicker">The Course</div>
      <h2 class="sec-title">Engineered <em>flat</em>.</h2>
      <p class="lead">26.2 miles of paved urban running with no climb longer than 200 ft. Net downhill, USATF-certified, single-loop with no doubling back. Designed by a course architect to give you the fastest legal time the Capital region can produce.</p>
    </div>

    <div class="course-grid">
      <div class="course-viz reveal">
        <div class="course-viz-head">
          <span>ELEVATION PROFILE</span>
          <span class="net">NET −12 FT</span>
        </div>
        <div class="profile-chart">
          <svg viewBox="0 0 500 200" preserveAspectRatio="none" aria-hidden="true">
            <line x1="0" y1="100" x2="500" y2="100" stroke="rgba(10,10,18,.08)" stroke-dasharray="4 4"/>
            <path d="M 0 100 L 30 95 L 60 88 L 90 92 L 120 85 L 150 90 L 180 82 L 210 90 L 240 85 L 270 88 L 300 96 L 330 92 L 360 100 L 390 96 L 420 102 L 450 98 L 480 104 L 500 108" 
                  fill="none" stroke="#2D5BFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M 0 100 L 30 95 L 60 88 L 90 92 L 120 85 L 150 90 L 180 82 L 210 90 L 240 85 L 270 88 L 300 96 L 330 92 L 360 100 L 390 96 L 420 102 L 450 98 L 480 104 L 500 108 L 500 200 L 0 200 Z" 
                  fill="rgba(45,91,255,.12)"/>
            <g fill="#2D5BFF">
              <circle cx="0" cy="100" r="4"/>
              <circle cx="500" cy="108" r="4"/>
              <circle cx="250" cy="86" r="3"/>
            </g>
            <g font-family="IBM Plex Mono" font-size="9" fill="rgba(10,10,18,.55)" letter-spacing="0.05em">
              <text x="0" y="124" text-anchor="start">START · 142 FT</text>
              <text x="250" y="78" text-anchor="middle">HALF · 158 FT</text>
              <text x="500" y="124" text-anchor="end">FINISH · 130 FT</text>
            </g>
          </svg>
        </div>
        <div class="profile-mile">
          <span>0 mi</span><span>6.5</span><span>13.1</span><span>19.7</span><span>26.2 mi</span>
        </div>
      </div>

      <div class="course-info reveal">
        <div class="ci-row"><span class="l">Total Distance</span><span class="v">26.2 <small>MI</small></span></div>
<div class="ci-row"><span class="l">Net Elevation</span><span class="v green">−12 FT</span></div>
        <div class="ci-row"><span class="l">Max Climb</span><span class="v">86 <small>FT · MILE 11</small></span></div>
        <div class="ci-row"><span class="l">USATF Cert</span><span class="v acc" style="font-size:1.05rem">MA-25-CFM</span></div>
        <div class="ci-row"><span class="l">Course Type</span><span class="v">Point-to-Point</span></div>
        <div class="ci-row"><span class="l">Cutoff Time</span><span class="v">6:00:00</span></div>
        <div class="ci-row"><span class="l">Pace Groups</span><span class="v acc">3:00 → 5:00 <small>EVERY :15</small></span></div>
      </div>
    </div>
  </div>
</section>

---
import { measurementReadyCopyForRace } from '../../../shared/private-mockup-value.mjs';
import { registrationPlatformLabel } from '../../../shared/registration-platform-label.mjs';
const { race } = Astro.props;
const platformLabel = registrationPlatformLabel(race.registration?.platform);
const measurementCopy = measurementReadyCopyForRace(race, {
  headline: `Register securely through ${platformLabel}.`,
  intro: `Review the race details here, then continue to ${platformLabel} when you are ready to enter.`,
  reportLabel: 'Review race details before checkout',
  reportBody: 'Confirm the date, start time, course support, packet pickup, policies, and current price before you leave this page.',
  separateLabel: `Entry confirmation comes from ${platformLabel}`,
  separateBody: `${platformLabel} handles the entry form, payment, confirmation email, transfers, and refunds.`
});
---
<section class="perf-measurement-panel" data-measurement-ready-panel>
  <div class="wrap perf-measurement-wrap">
    <div class="perf-measurement-card reveal">
      <div>
        <div class="kicker">{measurementCopy.kicker}</div>
        <h2 class="sec-title">{measurementCopy.headline}</h2>
        <p class="lead">{measurementCopy.intro}</p>
      </div>
      <div class="perf-measurement-points" aria-label="Registration details">
        <article>
          <strong>{measurementCopy.reportLabel}</strong>
          <p>{measurementCopy.reportBody}</p>
        </article>
        <article>
          <strong>{measurementCopy.separateLabel}</strong>
          <p>{measurementCopy.separateBody}</p>
        </article>
      </div>
    </div>
  </div>
</section>

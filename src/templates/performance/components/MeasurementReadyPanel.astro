---
import { measurementReadyCopyForRace } from '../../../shared/private-mockup-value.mjs';
const { race } = Astro.props;
const measurementCopy = measurementReadyCopyForRace(race, {
  headline: 'Give runners one clear registration path.',
  intro: 'Registration buttons stay close to the race facts runners check before continuing to the official provider.',
  reportLabel: 'What runners can review first',
  separateLabel: 'What stays with registration',
  separateBody: 'Race entry, payment, and confirmation remain inside the official registration platform.'
});
---
<section class="perf-measurement-panel" data-measurement-ready-panel>
  <div class="wrap perf-measurement-wrap">
    <div class="perf-measurement-card reveal">
      <div>
        <div class="kicker">{measurementCopy.kicker}</div>
        <h2 class="sec-title">{measurementCopy.headline}</h2>
        <p class="lead">{measurementCopy.intro}</p>
      </div>
      <div class="perf-measurement-points" aria-label="Registration details">
        <article>
          <strong>{measurementCopy.reportLabel}</strong>
          <p>{measurementCopy.reportBody}</p>
        </article>
        <article>
          <strong>{measurementCopy.separateLabel}</strong>
          <p>{measurementCopy.separateBody}</p>
        </article>
      </div>
    </div>
  </div>
</section>

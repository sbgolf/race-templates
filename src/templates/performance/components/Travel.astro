---
const { race } = Astro.props;
---
<section class="travel" id="travel">
  <div class="wrap">
    <div class="reveal">
      <div class="kicker">Travel</div>
      <h2 class="sec-title">Get to the <em>line</em>.</h2>
    </div>
    <div class="travel-grid stagger">
      <div class="tcard">
        <div class="icn">FLY</div>
        <h3>Capital Regional Airport</h3>
        <p>14 min by rideshare to expo, 22 min to start corrals. <strong>Race-weekend shuttle</strong> Friday–Sunday from arrivals to host hotels.</p>
      </div>
      <div class="tcard">
        <div class="icn">SLP</div>
        <h3>Host Hotels</h3>
        <p>5 host hotels within 0.4 mi of start. <strong>Block rate ~$189/night</strong>. Reserved through May 2026. Code at checkout.</p>
      </div>
      <div class="tcard">
        <div class="icn">RUN</div>
        <h3>Race Morning</h3>
        <p>Gear check opens 5:30 AM at finish, bus to start at 5:45. Last bus leaves at 6:15. <strong>Don't miss it.</strong></p>
      </div>
    </div>
  </div>
</section>

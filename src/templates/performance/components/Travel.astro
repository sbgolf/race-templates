---
const { race } = Astro.props;
const travel = race.travel || {};
const configuredItems = Array.isArray(travel.items) ? travel.items : [];
const items = configuredItems.length ? configuredItems : [travel.airport, travel.hotels, travel.race_morning].filter(Boolean);
---
{items.length > 0 && (
  <section class="travel" id="travel">
    <div class="wrap">
      <div class="reveal">
        <div class="kicker">Travel</div>
        <h2 class="sec-title">Get to the <em>line</em>.</h2>
      </div>
      <div class="travel-grid stagger">
        {items.map((item) => (
          <div class="tcard">
            <div class="icn">{item.label || item.icon || 'GO'}</div>
            <h3>{item.title || item.name}</h3>
            <p>{item.description || item.copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

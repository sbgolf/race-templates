---
import { registerClickAttributes } from '../../../shared/analytics/register-click.mjs';
const { race } = Astro.props;
const registrationUrl = race.registration?.url || '#entry';
const hasPrivateChecklist = Boolean(race.private_mockup && Array.isArray(race.runner_decision_checklist?.items) && race.runner_decision_checklist.items.length);
const primaryDistance = race.distances?.find((distance) => distance.featured) || race.distances?.[0] || {};
const raceName = race.identity?.name || 'Race day';
const tagline = race.identity?.tagline || primaryDistance.profile || 'A fast, certified race-day experience.';
const dateLabel = race.event?.date_label || race.runner_decision_checklist?.items?.find((item) => item.id === 'date')?.value || race.event?.date || '';
const locationLabel = race.event?.location || '';
const startLabel = primaryDistance.start_time || race.event?.time || '';
const certification = primaryDistance.certification || race.course?.certification || '';
const heroEyebrowParts = [certification, primaryDistance.profile, primaryDistance.distance].filter(Boolean);
const heroEyebrow = heroEyebrowParts.length ? heroEyebrowParts.join(' · ') : 'Performance race preview';
const lead = race.performance?.hero_lead || race.story?.paragraphs?.[0] || tagline;
const priceLabel = primaryDistance.price || (race.entry_tiers?.[0]?.price ? `$${race.entry_tiers[0].price}` : '');
const ctaLabel = race.registration?.cta_label || 'Register now';
const statLabel = race.performance?.hero_stat?.label || (certification ? 'USATF Certification' : primaryDistance.distance ? 'Featured Distance' : 'Race Focus');
const statValue = race.performance?.hero_stat?.value || certification || primaryDistance.distance || 'Performance';
const statDetail = race.performance?.hero_stat?.detail || primaryDistance.profile || race.organization?.name || '';
const clockLabel = race.performance?.clock?.label || 'Race Clock · Goal Pace';
const clockTime = race.performance?.clock?.time || race.pace_goals?.find((goal) => goal.featured)?.time || race.pace_goals?.[0]?.time || primaryDistance.cutoff || '1:45:00';
const clockSplits = race.performance?.clock?.splits || race.pace_goals?.find((goal) => goal.featured)?.splits?.slice(0, 3) || [
  { label: 'Mile 3', value: 'On pace' },
  { label: 'Halfway', value: 'Controlled' },
  { label: 'Finish', value: clockTime }
];
const clockFoot = race.performance?.clock?.footer || (certification ? `${certification} · certified course` : `${raceName} · race-day pace`);
---
<section class="hero" id="top">
  <div class="hero-grid">
    <div class="reveal">
      <div class="hero-eyebrow">{heroEyebrow}</div>
      <h1>{raceName}<br><span class="accent">fast-course preview.</span></h1>
      <div class="hero-date">
        {dateLabel && <strong>{dateLabel}</strong>}
        {dateLabel && locationLabel && <span>·</span>}
        {locationLabel && <span>{locationLabel}</span>}
        {startLabel && <span>·</span>}
        {startLabel && <span>{startLabel} start</span>}
      </div>
      <p class="lead">{lead}</p>
      <div class="hero-cta">
        <a class="btn btn-accent" href={registrationUrl} {...registerClickAttributes(race, 'hero-primary')}>{priceLabel ? `${ctaLabel} · ${priceLabel}` : ctaLabel}</a>
        <button class="btn btn-ghost" style="color:var(--paper);border-color:rgba(250,250,252,.3)" onclick={hasPrivateChecklist ? "scrollToId('runner-checklist')" : "scrollToId('pace')"}>{hasPrivateChecklist ? 'Review key race details' : 'Pace your race'}</button>
      </div>
      <div class="hero-keystat">
        <div class="label">{statLabel}</div>
        <div class="v">{statValue}<small>{statDetail}</small></div>
      </div>
    </div>

    <div class="reveal">
      <div class="race-clock">
        <div class="rc-label">{clockLabel}</div>
        <div class="rc-time">{clockTime}</div>
        <div class="rc-splits">
          {clockSplits.map((split) => <div class="rc-split fast"><div class="l">{split.label}</div><div class="v">{split.value}</div></div>)}
        </div>
        <div class="rc-foot">
          <span>{clockFoot}</span>
          <span class="live">LIVE</span>
        </div>
      </div>
    </div>
  </div>
</section>

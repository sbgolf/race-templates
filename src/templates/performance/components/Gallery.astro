---
const { race, galleryAssets = [] } = Astro.props;
const primaryDistance = race.distances?.find((distance) => distance.featured) || race.distances?.[0] || {};
const publicAssets = race.gallery || race.gallery_images || [];
const assets = Array.isArray(galleryAssets) && galleryAssets.length ? galleryAssets : publicAssets;
const raceName = race.identity?.name || 'Race day';
const distance = primaryDistance.distance || 'race distance';
const certification = primaryDistance.certification || race.course?.certification || '';
const captions = [
  certification ? `${certification.replace(/^USATF certified\s*/i, '')} · course certification.` : `${distance} · race distance.`,
  primaryDistance.profile || 'Course profile surfaced for quick scanning.',
  primaryDistance.aid_stations ? `${primaryDistance.aid_stations} aid stations listed on the course.` : 'Race-day details organized for quick runner scanning.',
  primaryDistance.cutoff ? `${primaryDistance.cutoff} course time limit.` : `${raceName} race-day guide.`
];
---
<section class="gallery" id="gallery">
  <div class="wrap">
    <div class="gallery-head reveal">
      <div class="kicker">Race Day</div>
      <h2 class="sec-title">{distance}, <em>focused</em>.</h2>
      <p class="lead">A performance-coded presentation for runners evaluating course speed, certification, timing, and the official registration path.</p>
    </div>

    <div class="gallery-grid reveal">
      {(assets.length ? assets.slice(0, 2) : [null, null]).map((asset, index) => (
        <figure class={`g-photo g${index + 1}`}>
          {asset?.src ? <img class="ph-img" src={asset.src} alt={asset.alt || `${raceName} race image`} loading="lazy" /> : <div class="ph-img ph-clock"><svg viewBox="0 0 600 280" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><rect x="80" y="80" width="440" height="120" fill="#0A0A12" stroke="#2D5BFF" stroke-width="2" rx="6"/><text x="300" y="158" text-anchor="middle" font-family="IBM Plex Mono" font-size="52" font-weight="700" fill="#FFD600">{distance}</text></svg></div>}
          <figcaption>{captions[index] || raceName}</figcaption>
        </figure>
      ))}
      {captions.slice(2).map((caption, index) => (
        <figure class={`g-photo g${index + 3}`}>
          <div class="ph-img ph-pace"><svg viewBox="0 0 400 280" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><rect x="78" y="118" width="244" height="48" rx="8" fill="#2D5BFF"/><path d="M112 152h176" stroke="#FAFAFC" stroke-width="8" stroke-linecap="round" stroke-dasharray="18 14" opacity=".9"/><circle cx="132" cy="140" r="10" fill="#FFD600"/><circle cx="268" cy="140" r="10" fill="#FFD600"/></svg></div>
          <figcaption>{caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

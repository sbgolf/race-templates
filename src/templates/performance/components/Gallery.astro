---
const { race } = Astro.props;
---
<section class="gallery" id="gallery">
  <div class="wrap">
    <div class="gallery-head reveal">
      <div class="kicker">Race Day</div>
      <h2 class="sec-title">26.2, <em>captured</em>.</h2>
      <p class="lead">A morning when 4,200 runners try for a time they've been training for all year. The clock doesn't lie. Neither do these.</p>
    </div>

    <div class="gallery-grid reveal">
      <figure class="g-photo g1">
        <div class="ph-img ph-clock">
          <svg viewBox="0 0 600 280" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <rect x="80" y="80" width="440" height="120" fill="#0A0A12" stroke="#2D5BFF" stroke-width="2" rx="6"/>
            <g font-family="IBM Plex Mono" font-size="68" font-weight="700" fill="#FFD600" letter-spacing="0.04em">
              <text x="300" y="158" text-anchor="middle">2:11:24</text>
            </g>
            <circle cx="540" cy="100" r="6" fill="#FF3D3D">
              <animate attributeName="opacity" values="1;0.3;1" dur="1.4s" repeatCount="indefinite"/>
</circle>
            <text x="300" y="232" font-family="IBM Plex Mono" font-size="11" fill="rgba(255,255,255,0.6)" text-anchor="middle" letter-spacing="0.2em">FINISH LINE · GUN TIME</text>
          </svg>
        </div>
        <figcaption><span class="t">2:11:24</span> · The 2025 course record falls at the tape.</figcaption>
      </figure>

      <figure class="g-photo g2">
        <div class="ph-img ph-tape">
          <svg viewBox="0 0 300 280" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <rect x="0" y="100" width="300" height="14" fill="#FAFAFC" opacity=".95"/>
            <rect x="0" y="114" width="300" height="2" fill="#FFD600"/>
            <g fill="#0A0A12" opacity=".82">
              <ellipse cx="150" cy="175" rx="13" ry="16"/>
              <rect x="143" y="190" width="14" height="50"/>
              <rect x="135" y="200" width="6" height="40" transform="rotate(-12 138 220)"/>
              <rect x="159" y="200" width="6" height="40" transform="rotate(12 162 220)"/>
            </g>
          </svg>
        </div>
        <figcaption>The break.</figcaption>
      </figure>

      <figure class="g-photo g3">
        <div class="ph-img ph-pack">
          <svg viewBox="0 0 600 280" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <rect x="0" y="220" width="600" height="60" fill="#0A0A12" opacity=".5"/>
            <rect x="0" y="240" width="600" height="2" fill="#FFD600" opacity=".5"/>
            <g fill="#0A0A12" opacity=".82">
              <ellipse cx="100" cy="180" rx="12" ry="14"/><rect x="93" y="194" width="14" height="40"/>
              <ellipse cx="170" cy="178" rx="12" ry="14"/><rect x="163" y="192" width="14" height="42"/>
              <ellipse cx="240" cy="182" rx="12" ry="14"/><rect x="233" y="196" width="14" height="38"/>
              <ellipse cx="310" cy="180" rx="12" ry="14"/><rect x="303" y="194" width="14" height="40"/>
              <ellipse cx="380" cy="178" rx="12" ry="14"/><rect x="373" y="192" width="14" height="42"/>
              <ellipse cx="450" cy="182" rx="12" ry="14"/><rect x="443" y="196" width="14" height="38"/>
              <ellipse cx="520" cy="180" rx="12" ry="14"/><rect x="513" y="194" width="14" height="40"/>
            </g>
          </svg>
        </div>
        <figcaption><span class="t">Mile 18.</span> The lead pack starts to thin.</figcaption>
      </figure>

      <figure class="g-photo g4">
        <div class="ph-img ph-pace">
          <svg viewBox="0 0 400 280" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <g fill="#0A0A12" opacity=".82">
              <ellipse cx="200" cy="160" rx="14" ry="17"/>
              <rect x="192" y="176" width="16" height="48"/>
            </g>
            <rect x="160" y="120" width="80" height="32" fill="#2D5BFF"/>
            <text x="200" y="142" font-family="Big Shoulders Display" font-size="20" font-weight="800" fill="#FAFAFC" text-anchor="middle">3:30</text>
            <line x1="190" y1="152" x2="200" y2="172" stroke="#0A0A12" stroke-width="3" opacity=".82"/>
          </svg>
        </div>
        <figcaption><span class="t">3:30 group.</span> Stay on the sign. Don't think.</figcaption>
      </figure>

      <figure class="g-photo g5">
        <div class="ph-img ph-grit">
          <svg viewBox="0 0 400 280" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <g fill="#0A0A12" opacity=".88">
              <ellipse cx="200" cy="120" rx="22" ry="28"/>
              <rect x="188" y="146" width="24" height="60"/>
              <ellipse cx="195" cy="115" rx="2" ry="3" fill="#FAFAFC" opacity=".4"/>
              <ellipse cx="205" cy="115" rx="2" ry="3" fill="#FAFAFC" opacity=".4"/>
            </g>
            <rect x="186" y="190" width="28" height="3" fill="#2D5BFF"/>
            <text x="200" y="186" font-family="IBM Plex Mono" font-size="9" fill="#FAFAFC" opacity=".6" text-anchor="middle">BIB 0142</text>
          </svg>
        </div>
        <figcaption><span class="t">Mile 23.</span> The wall. Then through it.</figcaption>
</figure>

      <figure class="g-photo g6">
        <div class="ph-img ph-celebrate">
          <svg viewBox="0 0 400 280" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <g fill="#0A0A12" opacity=".88">
              <ellipse cx="200" cy="120" rx="16" ry="20"/>
              <rect x="190" y="138" width="20" height="44"/>
              <rect x="172" y="100" width="6" height="44" transform="rotate(-30 175 122)"/>
              <rect x="220" y="100" width="6" height="44" transform="rotate(30 225 122)"/>
            </g>
            <circle cx="180" cy="50" r="3" fill="#FAFAFC"/>
            <circle cx="240" cy="60" r="3" fill="#FAFAFC"/>
            <circle cx="100" cy="80" r="3" fill="#FAFAFC"/>
            <circle cx="300" cy="70" r="3" fill="#FAFAFC"/>
          </svg>
        </div>
        <figcaption><span class="t">3:14:22.</span> First sub-3:15 marathon.</figcaption>
      </figure>
    </div>
  </div>
</section>

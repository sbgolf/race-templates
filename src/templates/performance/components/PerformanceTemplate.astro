---
import '../styles/tokens.css';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import StatBar from './StatBar.astro';
import RunnerDecisionChecklist from './RunnerDecisionChecklist.astro';
import RegistrationDecisionCard from './RegistrationDecisionCard.astro';
import TrustSignalsBand from './TrustSignalsBand.astro';
import MeasurementReadyPanel from './MeasurementReadyPanel.astro';
import Course from './Course.astro';
import PacePicker from './PacePicker.astro';
import Records from './Records.astro';
import Gallery from './Gallery.astro';
import Entry from './Entry.astro';
import Travel from './Travel.astro';
import Sponsors from './Sponsors.astro';
import FAQ from './FAQ.astro';
import Finale from './Finale.astro';
import Footer from './Footer.astro';
const { race, isPrivateMockup = false, galleryAssets } = Astro.props;
---
<Nav race={race} />
<main id="main-content">
<Hero race={race} isPrivateMockup={isPrivateMockup} />
<StatBar race={race} />
{isPrivateMockup && <RunnerDecisionChecklist race={race} />}
{isPrivateMockup && <TrustSignalsBand race={race} />}
{isPrivateMockup && <RegistrationDecisionCard race={race} />}
<Course race={race} />
<PacePicker race={race} />
<Records race={race} isPrivateMockup={isPrivateMockup} />
<Gallery race={race} galleryAssets={galleryAssets} />
<Entry race={race} />
<Travel race={race} />
<Sponsors race={race} />
<FAQ race={race} />
{isPrivateMockup && <MeasurementReadyPanel race={race} />}
<Finale race={race} />
</main>
<Footer race={race} />
<script is:inline>

  const nav=document.getElementById('nav');
  const burger=document.getElementById('burger');
  const navLinks=document.getElementById('navLinks');
  const revealEls=document.querySelectorAll('.reveal,.stagger');
  document.documentElement.classList.add('js-reveal');

  function showAllReveals(){
    revealEls.forEach((el)=>el.classList.add('in'));
  }

  function initReveals(){
    if(!('IntersectionObserver' in window)){showAllReveals();return;}
    const io=new IntersectionObserver((entries)=>{
      entries.forEach(en=>{
        if(en.isIntersecting){
          const el=en.target;
          if(el.classList.contains('stagger')){[...el.children].forEach((c,i)=>{c.style.transitionDelay=(i*80)+'ms';});}
          el.classList.add('in');io.unobserve(el);
        }
      });
    },{threshold:.08,rootMargin:'0px 0px -8% 0px'});
    revealEls.forEach((el)=>io.observe(el));
    setTimeout(showAllReveals,1400);
  }

  initReveals();

  function closeMenu(){
    navLinks?.classList.remove('open');
    nav?.classList.remove('menu-open');
    burger?.setAttribute('aria-expanded','false');
    document.body.classList.remove('no-scroll');
  }

  function scrollToId(id){
    const target=document.getElementById(id);
    if(target) target.scrollIntoView({behavior:'smooth'});
    closeMenu();
  }

  if(nav){addEventListener('scroll',()=>nav.classList.toggle('scrolled',scrollY>40));}

  function toggleMenu(){
    if(!navLinks) return;
    const isOpen=navLinks.classList.toggle('open');
    nav?.classList.toggle('menu-open',isOpen);
    burger?.setAttribute('aria-expanded',String(isOpen));
    document.body.classList.toggle('no-scroll',isOpen);
  }
  burger?.addEventListener('click',toggleMenu);
  navLinks?.querySelectorAll('a,button').forEach(el=>el.addEventListener('click',closeMenu));
  document.addEventListener('keydown',(e)=>{if(e.key==='Escape')closeMenu()});

  document.querySelectorAll('.faq-q').forEach(q=>{
    q.addEventListener('click',()=>{
      const item=q.parentElement;
      const a=item?.querySelector('.faq-a');
      if(!item||!a) return;
      const open=item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i=>{
        i.classList.remove('open');
        const answer=i.querySelector('.faq-a');
        if(answer) answer.style.maxHeight=null;
      });
      if(!open){item.classList.add('open');a.style.maxHeight=a.scrollHeight+'px';}
    });
  });

  // Pace picker — updates summary + configured checkpoint splits.
  function pickPace(btn){
    const paceData=window.STARTLINE_PACE_DATA||{};
    document.querySelectorAll('.pace-tab').forEach(t=>t.classList.remove('active'));
    btn.classList.add('active');
    const g=btn.dataset.goal,data=paceData[g];
    if(!data) return;
    const paceGoal=document.getElementById('paceGoal');
    const paceMile=document.getElementById('paceMile');
    const paceKm=document.getElementById('paceKm');
    const paceHalf=document.getElementById('paceHalf');
    if(paceGoal) paceGoal.textContent=data.finish;
    if(paceMile) paceMile.textContent=data.mile;
    if(paceKm) paceKm.textContent=data.km;
    if(paceHalf) paceHalf.textContent=data.half;
    document.querySelectorAll('.pace-row.body').forEach(row=>{
      const m=row.dataset.mile;
      const split=row.querySelector('.split');
      const elapsed=row.querySelector('.elapsed');
      const paceCell=row.querySelector('div:nth-child(3)');
      if(split) split.textContent=data.splitTimes[m]||data.splits[m]||'';
      if(elapsed) elapsed.textContent=data.splits[m]||'';
      if(paceCell) paceCell.textContent=data.mile;
    });
  }

  function notify(btn,msg){const orig=btn.textContent;btn.textContent=msg;btn.disabled=true;setTimeout(()=>{btn.textContent=orig;btn.disabled=false},2400);}

  document.querySelectorAll('a[href^="#"]').forEach(a=>{
    a.addEventListener('click',(e)=>{
      const href=a.getAttribute('href');e.preventDefault();
      if(href&&href.length>1)scrollToId(href.substring(1));
    });
  });

</script>

---
import '../styles/tokens.css';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import StatBar from './StatBar.astro';
import PrivateValueNarrative from './PrivateValueNarrative.astro';
import RunnerDecisionChecklist from './RunnerDecisionChecklist.astro';
import RegistrationDecisionCard from './RegistrationDecisionCard.astro';
import TrustSignalsBand from './TrustSignalsBand.astro';
import MeasurementReadyPanel from './MeasurementReadyPanel.astro';
import Course from './Course.astro';
import PacePicker from './PacePicker.astro';
import Records from './Records.astro';
import Gallery from './Gallery.astro';
import Entry from './Entry.astro';
import Travel from './Travel.astro';
import Sponsors from './Sponsors.astro';
import FAQ from './FAQ.astro';
import Finale from './Finale.astro';
import Footer from './Footer.astro';
const { race } = Astro.props;
const isPrivateMockup = Boolean(race.private_mockup);
---
<Nav race={race} />
<main id="main-content">
<Hero race={race} />
<StatBar race={race} />
{isPrivateMockup && <PrivateValueNarrative race={race} />}
{isPrivateMockup && <TrustSignalsBand race={race} />}
<Course race={race} />
<PacePicker race={race} />
<Records race={race} />
<Gallery race={race} />
{isPrivateMockup && <RunnerDecisionChecklist race={race} />}
{isPrivateMockup && <RegistrationDecisionCard race={race} />}
<Entry race={race} />
<Travel race={race} />
<Sponsors race={race} />
<FAQ race={race} />
{isPrivateMockup && <MeasurementReadyPanel race={race} />}
<Finale race={race} />
</main>
<Footer race={race} />
<script is:inline>

  function scrollToId(id){document.getElementById(id).scrollIntoView({behavior:'smooth'});closeMenu();}

  const nav=document.getElementById('nav');
  addEventListener('scroll',()=>nav.classList.toggle('scrolled',scrollY>40));

  const burger=document.getElementById('burger'),navLinks=document.getElementById('navLinks');
  function closeMenu(){navLinks.classList.remove('open');nav.classList.remove('menu-open');document.body.classList.remove('no-scroll')}
  function toggleMenu(){
    const isOpen=navLinks.classList.toggle('open');
    nav.classList.toggle('menu-open',isOpen);
    document.body.classList.toggle('no-scroll',isOpen);
  }
  burger.addEventListener('click',toggleMenu);
  navLinks.querySelectorAll('a,button').forEach(el=>el.addEventListener('click',closeMenu));
  document.addEventListener('keydown',(e)=>{if(e.key==='Escape')closeMenu()});

  document.querySelectorAll('.faq-q').forEach(q=>{
    q.addEventListener('click',()=>{
      const item=q.parentElement,a=item.querySelector('.faq-a'),open=item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i=>{i.classList.remove('open');i.querySelector('.faq-a').style.maxHeight=null});
      if(!open){item.classList.add('open');a.style.maxHeight=a.scrollHeight+'px';}
    });
  });

  // Pace picker — updates summary + every mile split
  const paceData={
    '245':{finish:'2:45:00',mile:'6:18',km:'3:55',half:'1:22:30',splits:{1:'0:06:18',5:'0:31:30',10:'1:03:00','13.1':'1:22:30',15:'1:34:30',20:'2:06:00',25:'2:37:30','26.2':'2:45:00'},splitTimes:{1:'6:18',5:'31:30',10:'1:03:00','13.1':'1:22:30',15:'1:34:30',20:'2:06:00',25:'2:37:30','26.2':'2:45:00'}},
    '300':{finish:'3:00:00',mile:'6:52',km:'4:16',half:'1:30:00',splits:{1:'0:06:52',5:'0:34:20',10:'1:08:40','13.1':'1:30:00',15:'1:43:00',20:'2:17:20',25:'2:51:40','26.2':'3:00:00'},splitTimes:{1:'6:52',5:'34:20',10:'1:08:40','13.1':'1:30:00',15:'1:43:00',20:'2:17:20',25:'2:51:40','26.2':'3:00:00'}},
    '315':{finish:'3:15:00',mile:'7:26',km:'4:37',half:'1:37:30',splits:{1:'0:07:26',5:'0:37:10',10:'1:14:20','13.1':'1:37:30',15:'1:51:30',20:'2:28:40',25:'3:05:50','26.2':'3:15:00'},splitTimes:{1:'7:26',5:'37:10',10:'1:14:20','13.1':'1:37:30',15:'1:51:30',20:'2:28:40',25:'3:05:50','26.2':'3:15:00'}},
    '330':{finish:'3:30:00',mile:'8:01',km:'4:58',half:'1:45:00',splits:{1:'0:08:01',5:'0:40:05',10:'1:20:10','13.1':'1:45:00',15:'2:00:15',20:'2:40:20',25:'3:20:25','26.2':'3:30:00'},splitTimes:{1:'8:01',5:'40:05',10:'1:20:10','13.1':'1:45:00',15:'2:00:15',20:'2:40:20',25:'3:20:25','26.2':'3:30:00'}},
    '345':{finish:'3:45:00',mile:'8:35',km:'5:20',half:'1:52:30',splits:{1:'0:08:35',5:'0:42:55',10:'1:25:50','13.1':'1:52:30',15:'2:08:45',20:'2:51:40',25:'3:34:35','26.2':'3:45:00'},splitTimes:{1:'8:35',5:'42:55',10:'1:25:50','13.1':'1:52:30',15:'2:08:45',20:'2:51:40',25:'3:34:35','26.2':'3:45:00'}},
    '400':{finish:'4:00:00',mile:'9:09',km:'5:41',half:'2:00:00',splits:{1:'0:09:09',5:'0:45:45',10:'1:31:30','13.1':'2:00:00',15:'2:17:15',20:'3:03:00',25:'3:48:45','26.2':'4:00:00'},splitTimes:{1:'9:09',5:'45:45',10:'1:31:30','13.1':'2:00:00',15:'2:17:15',20:'3:03:00',25:'3:48:45','26.2':'4:00:00'}},
    '415':{finish:'4:15:00',mile:'9:44',km:'6:03',half:'2:07:30',splits:{1:'0:09:44',5:'0:48:40',10:'1:37:20','13.1':'2:07:30',15:'2:25:45',20:'3:14:40',25:'4:02:55','26.2':'4:15:00'},splitTimes:{1:'9:44',5:'48:40',10:'1:37:20','13.1':'2:07:30',15:'2:25:45',20:'3:14:40',25:'4:02:55','26.2':'4:15:00'}}
  };

  function pickPace(btn){
    document.querySelectorAll('.pace-tab').forEach(t=>t.classList.remove('active'));
    btn.classList.add('active');
    const g=btn.dataset.goal,data=paceData[g];
    document.getElementById('paceGoal').textContent=data.finish;
    document.getElementById('paceMile').textContent=data.mile;
    document.getElementById('paceKm').textContent=data.km;
    document.getElementById('paceHalf').textContent=data.half;
    document.querySelectorAll('.pace-row.body').forEach(row=>{
      const m=row.dataset.mile;
      row.querySelector('.split').textContent=data.splitTimes[m];
      row.querySelector('.elapsed').textContent=data.splits[m];
      row.querySelector('div:nth-child(3)').textContent=data.mile;
    });
  }

  function notify(btn,msg){const orig=btn.textContent;btn.textContent=msg;btn.disabled=true;setTimeout(()=>{btn.textContent=orig;btn.disabled=false},2400);}

  const io=new IntersectionObserver((entries)=>{
    entries.forEach(en=>{
      if(en.isIntersecting){
        const el=en.target;
        if(el.classList.contains('stagger')){[...el.children].forEach((c,i)=>{c.style.transitionDelay=(i*80)+'ms';});}
        el.classList.add('in');io.unobserve(el);
      }
    });
  },{threshold:.14});
  document.querySelectorAll('.reveal,.stagger').forEach(el=>io.observe(el));

  document.querySelectorAll('a[href^="#"]').forEach(a=>{
    a.addEventListener('click',(e)=>{
      const href=a.getAttribute('href');e.preventDefault();
      if(href.length>1)scrollToId(href.substring(1));
    });
  });

</script>

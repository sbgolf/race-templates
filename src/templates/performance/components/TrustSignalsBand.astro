---
import { shouldRenderTrustSignalsBand, trustSignalsForRace } from '../../../shared/private-mockup-trust.mjs';
const { race } = Astro.props;
const shouldRender = shouldRenderTrustSignalsBand(race);
const signals = trustSignalsForRace(race);
---
{shouldRender ? (
  <section class="perf-trust-band" data-trust-signals-band>
    <div class="wrap perf-private-wrap">
      <div class="perf-private-head reveal">
        <div>
          <div class="kicker">Race confidence</div>
          <h2 class="sec-title">Why runners trust this race faster.</h2>
        </div>
        <p class="lead">After the decision checklist, this proof band avoids repeating the same basics and highlights the credibility signals performance runners use to compare races quickly.</p>
      </div>
      <div class="perf-trust-grid stagger">
        {signals.map((signal) => (
          <article class="perf-trust-card" data-trust-signal-id={signal.id === 'source-backed' ? 'fact-reviewed' : signal.id}>
            <span>{signal.label}</span>
            <strong>{signal.value}</strong>
            {signal.detail ? <p>{signal.detail}</p> : null}
          </article>
        ))}
      </div>
    </div>
  </section>
) : null}

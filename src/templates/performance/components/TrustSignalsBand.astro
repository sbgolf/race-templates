---
import { shouldRenderTrustSignalsBand, trustSignalsForRace } from '../../../shared/private-mockup-trust.mjs';
const { race } = Astro.props;
const shouldRender = race.private_mockup?.suppress_trust_signals !== true && shouldRenderTrustSignalsBand(race);
const signals = trustSignalsForRace(race);
---
{shouldRender ? (
  <section class="perf-trust-band" data-trust-signals-band>
    <div class="wrap perf-private-wrap">
      <div class="perf-private-head reveal">
        <div>
          <div class="kicker">Race confidence</div>
          <h2 class="sec-title">Why runners choose this start line.</h2>
        </div>
        <p class="lead">Certification, field size, schedule clarity, and official registration status are easy to confirm before race day.</p>
      </div>
      <div class="perf-trust-grid stagger">
        {signals.map((signal) => (
          <article class="perf-trust-card" data-trust-signal-id={signal.id}>
            <span>{signal.label}</span>
            <strong>{signal.value}</strong>
            {signal.detail ? <p>{signal.detail}</p> : null}
          </article>
        ))}
      </div>
    </div>
  </section>
) : null}

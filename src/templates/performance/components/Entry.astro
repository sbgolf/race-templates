---
import { registerClickAttributes } from '../../../shared/analytics/register-click.mjs';
const { race } = Astro.props;
const registrationUrl = race.registration?.url || '#entry';
const primaryDistance = race.distances?.find((distance) => distance.featured) || race.distances?.[0] || {};
const tiers = Array.isArray(race.entry_tiers) && race.entry_tiers.length ? race.entry_tiers : [
  {
    name: primaryDistance.name || 'Race Entry',
    price: primaryDistance.price_amount || primaryDistance.price || '',
    subtitle: primaryDistance.start_time ? `${primaryDistance.start_time} start` : 'Official registration',
    features: [primaryDistance.distance, primaryDistance.profile, primaryDistance.certification, primaryDistance.aid_stations ? `${primaryDistance.aid_stations} aid stations listed` : '', primaryDistance.cutoff ? `${primaryDistance.cutoff} time limit` : ''].filter(Boolean)
  }
];
---
<section class="entry" id="entry">
  <div class="wrap">
    <div class="reveal">
      <div class="kicker">Registration</div>
      <h2 class="sec-title">Enter the <em>chase</em>.</h2>
      <p class="lead">{race.registration?.intro || 'Keep official registration easy to find while giving performance-minded runners the facts they scan before committing.'}</p>
    </div>

    <div class="entry-grid stagger">
      {tiers.map((tier, index) => {
        const price = typeof tier.price === 'number' ? `$${tier.price}` : tier.price;
        const features = Array.isArray(tier.features) ? tier.features.filter(Boolean) : [];
        return (
          <div class={`etier ${tier.featured || index === 0 ? 'featured' : ''}`}>
            <h3>{tier.name}</h3>
            {tier.subtitle && <div class="sub">{tier.subtitle}</div>}
            {price && <div class="pp">{price}<small>/ bib</small></div>}
            {features.length > 0 && <ul>{features.map((feature) => <li>{feature}</li>)}</ul>}
            <a class={index === 0 ? 'btn btn-accent' : 'btn btn-yellow'} href={registrationUrl} {...registerClickAttributes(race, `entry-distance-${primaryDistance.id || 'race'}-${tier.name?.toLowerCase?.().replace(/[^a-z0-9]+/g, '-') || index}`)}>{tier.cta_label || race.registration?.cta_label || 'Register now'}</a>
          </div>
        );
      })}
    </div>
  </div>
</section>

---
import { registerClickAttributes } from '../../../shared/analytics/register-click.mjs';
import { registrationDecisionCopyForRace } from '../../../shared/private-mockup-value.mjs';
import { registrationPlatformLabel } from '../../../shared/registration-platform-label.mjs';
const { race } = Astro.props;
const registerUrl = race.registration?.url || '#entry';
const platformLabel = registrationPlatformLabel(race.registration?.platform);
const items = Array.isArray(race.runner_decision_checklist?.items) ? race.runner_decision_checklist.items : [];
const itemById = (id) => items.find((item) => item.id === id);
const price = itemById('price')?.value || race.distances?.[0]?.price || race.registration?.price_note;
const priceDetail = itemById('price')?.detail || race.registration?.price_note;
const registrationStatus = race.registration?.intro;
const closedStatuses = new Set(['closed', 'sold_out', 'transfer_only']);
const isClosedStatus = closedStatuses.has(race.registration?.status);
const decisionCopy = registrationDecisionCopyForRace(race, {
  kicker: isClosedStatus ? 'Official race status' : 'Clear path to registration',
  headline: isClosedStatus ? 'Check the official race status.' : 'Ready to register? Finish on the official platform.',
  body: isClosedStatus
    ? `Review the race-day details here, then check ${platformLabel} for the official entry status, policies, and participant tools.`
    : `The runner facts stay on this page; the entry form, payment, and confirmation continue on ${platformLabel}. This keeps the decision path clear without asking runners to sort through repeated CTAs.`
});
const platform = decisionCopy.platform || 'Official registration';
const statusLabel = isClosedStatus ? (race.registration?.status_label || 'Online registration closed') : 'Registration is open';
const decisionFacts = [
  price ? { label: isClosedStatus ? 'Current status' : 'Current price', value: price, detail: priceDetail } : null,
  registrationStatus ? { label: 'Registration status', value: statusLabel, detail: registrationStatus } : null,
  platform ? { label: 'Official registration', value: platform } : null
].filter(Boolean);
const registerLabel = decisionCopy.ctaLabel;
const shouldRender = race.private_mockup?.suppress_registration_decision !== true;
---
{shouldRender ? (
<section class="perf-registration-decision" data-registration-decision-card>
  <div class="wrap perf-decision-wrap">
    <div class="perf-decision-card reveal">
      <div class="perf-decision-copy">
        <div class="kicker">{decisionCopy.kicker}</div>
        <h2 class="sec-title">{decisionCopy.headline}</h2>
        <p class="lead">{decisionCopy.body}</p>
      </div>
      <div class="perf-decision-actions">
        {decisionFacts.length ? (
          <div class="perf-decision-facts" aria-label="Official registration details">
            {decisionFacts.map((fact) => (
              <div>
                <span>{fact.label}</span>
                <strong>{fact.value}</strong>
                {fact.detail ? <p>{fact.detail}</p> : null}
              </div>
            ))}
          </div>
        ) : null}
        <a class="btn btn-accent" href={registerUrl} target="_blank" rel="noopener" {...registerClickAttributes(race, 'registration-decision-card')}>{registerLabel}</a>
      </div>
    </div>
  </div>
</section>
) : null}

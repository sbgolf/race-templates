---
const { race } = Astro.props;
const faqs = Array.isArray(race.faqs) ? race.faqs.filter((faq) => faq?.question && faq?.answer) : [];
---
{faqs.length > 0 && (
  <section class="faq" id="faq">
    <div class="wrap faq-wrap">
      <div class="reveal">
        <div class="kicker">Race Logistics</div>
        <h2 class="sec-title">Common <em>questions</em>.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((faq) => (
          <div class="faq-item">
            <button class="faq-q">{faq.question}<span class="pm"></span></button>
            <div class="faq-a"><p>{faq.answer}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

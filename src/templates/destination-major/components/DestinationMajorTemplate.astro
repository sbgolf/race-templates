---
import { registerClickAttributes } from "../../../shared/analytics/register-click.mjs";
import { registrationPlatformLabel } from "../../../shared/registration-platform-label.mjs";
import SocialLinksRow from "../../../shared/components/SocialLinksRow.astro";
import PastRacePhotos from "../../../shared/components/PastRacePhotos.astro";
import { shouldRenderTrustSignalsBand, trustSignalsForRace } from "../../../shared/private-mockup-trust.mjs";
import { privateValueNarrativeForRace, registrationDecisionCopyForRace } from "../../../shared/private-mockup-value.mjs";

const { race } = Astro.props;
const isPrivateMockup = Boolean(race.private_mockup);
const registrationUrl = race.registration?.url || '#entry';
const registrationStatusDefaults = {
  open: { label: 'Registration open', cta: 'Register now' },
  limited: { label: 'Limited spots remaining', cta: 'Register while spots remain' },
  waitlist: { label: 'Waitlist open', cta: 'Join the waitlist' },
  sold_out: { label: 'Sold out', cta: 'View registration details' },
  transfer_only: { label: 'Transfers only', cta: 'View transfer options' },
  closed: { label: 'Registration closed', cta: 'View race details' }
};
const registrationStatus = race.registration?.status && registrationStatusDefaults[race.registration.status]
  ? race.registration.status
  : null;
const registrationStatusCopy = registrationStatus ? {
  status: registrationStatus,
  label: race.registration?.status_label || registrationStatusDefaults[registrationStatus].label,
  detail: race.registration?.status_detail,
  cta: race.registration?.status_cta_label || registrationStatusDefaults[registrationStatus].cta
} : null;
const registrationLabel = registrationStatusCopy?.cta || race.registration?.cta_label || 'Register now';
const platformLabel = registrationPlatformLabel(race.registration?.platform);
const privateValue = privateValueNarrativeForRace(race, {
  headline: 'A premium race story that makes the next step clear.',
  intro: `Runners can review the destination story, key race facts, and trust details before continuing to ${platformLabel}.`,
  improved: [
    'Clear race details sit before registration decisions.',
    `The ${platformLabel} link stays easy to reach after runners review the race-day details.`,
    'Runner decision sections stay focused on race facts, travel details, and entry confidence.'
  ]
});
const registrationDecisionCopy = registrationDecisionCopyForRace(race, {
  kicker: 'Official registration',
  headline: 'Make the next step unmistakable.',
  body: `Review the destination-weekend details here, then continue to ${platformLabel} when you are ready to enter.`
});
const registerAttrs = (placement) => registerClickAttributes(race, placement);
const checklistItems = Array.isArray(race.runner_decision_checklist?.items) ? race.runner_decision_checklist.items : [];
const hasRunnerChecklist = isPrivateMockup && checklistItems.length > 0;
const trustSignals = trustSignalsForRace(race);
const showTrustSignalsBand = isPrivateMockup && shouldRenderTrustSignalsBand(race);
const primaryDistance = race.distances?.find((distance) => distance.featured) || race.distances?.[0] || {};
const entryTiers = (race.distances?.length ? race.distances : [primaryDistance]).filter(Boolean);
const scheduleItems = Array.isArray(race.schedule) ? race.schedule : [];
const faqItems = Array.isArray(race.faqs) ? race.faqs : [];
const hasText = (value) => typeof value === 'string' && value.trim().length > 0;
const travelLogistics = race.travel_logistics || {};
const travelItems = Array.isArray(travelLogistics.items)
  ? travelLogistics.items.filter((item) => item && (hasText(item.title) || hasText(item.label)) && hasText(item.text))
  : [];
const travelLinks = Array.isArray(travelLogistics.links)
  ? travelLogistics.links.filter((link) => link && hasText(link.label) && hasText(link.url))
  : [];
const hasTravelLogistics = hasText(travelLogistics.intro) || travelItems.length > 0 || travelLinks.length > 0;
const destinationIconAliases = {
  aid: 'water',
  aid_support: 'water',
  airport: 'air',
  altitude: 'mountain',
  arrival: 'calendar',
  camping: 'tent',
  coast: 'wave',
  course: 'map',
  course_profile: 'map',
  descent: 'descent',
  ferry: 'ferry',
  finish: 'pin',
  lodging: 'lodging',
  map: 'map',
  packet: 'bib',
  parking: 'parking',
  shuttle: 'shuttle',
  start: 'pin',
  start_finish: 'pin',
  travel_links: 'link',
  links: 'link'
};
const destinationIconSvg = {
  air: '<svg viewBox="0 0 32 32" focusable="false"><path d="M5 18.5 27 7l-7.5 21-4.5-8.5-10-1Z"/><path d="M15 19.5 27 7"/></svg>',
  bib: '<svg viewBox="0 0 32 32" focusable="false"><path d="M9 6h14l2 5v15H7V11l2-5Z"/><path d="M12 14h8M12 19h3M18 19h2"/><path d="M11 6v5M21 6v5"/></svg>',
  calendar: '<svg viewBox="0 0 32 32" focusable="false"><path d="M8 8h16v17H8z"/><path d="M8 13h16M12 5v6M20 5v6"/><path d="M12 17h3M17 17h3M12 21h3"/></svg>',
  descent: '<svg viewBox="0 0 32 32" focusable="false"><path d="M6 10h8l4 6 8 6"/><path d="M22 15v7h-7"/><path d="M5 24h22"/></svg>',
  ferry: '<svg viewBox="0 0 32 32" focusable="false"><path d="M6 15h20l-3 7H9l-3-7Z"/><path d="M11 10h10v5H11z"/><path d="M6 25c3-2 5 2 8 0s5 2 8 0 4 1 5 0"/></svg>',
  link: '<svg viewBox="0 0 32 32" focusable="false"><path d="M13.5 10.5 16 8a5 5 0 0 1 7 7l-3 3a5 5 0 0 1-7 0"/><path d="M18.5 21.5 16 24a5 5 0 0 1-7-7l3-3a5 5 0 0 1 7 0"/></svg>',
  lodging: '<svg viewBox="0 0 32 32" focusable="false"><path d="M6 26V14l10-8 10 8v12"/><path d="M11 26v-8h10v8M13 14h6"/></svg>',
  map: '<svg viewBox="0 0 32 32" focusable="false"><path d="M6 9v17l7-3 6 3 7-3V6l-7 3-6-3-7 3Z"/><path d="M13 6v17M19 9v17"/></svg>',
  mountain: '<svg viewBox="0 0 32 32" focusable="false"><path d="M4 25 14 7l5 8 3-4 6 14H4Z"/><path d="M14 7 12 19l4-3 3 5"/></svg>',
  neutral: '<svg viewBox="0 0 32 32" focusable="false"><path d="M6 22 14 8l4 7 3-4 5 11H6Z"/><path d="M7 25h18"/></svg>',
  parking: '<svg viewBox="0 0 32 32" focusable="false"><path d="M10 26V6h8a6 6 0 0 1 0 12h-8"/><path d="M10 18h8"/></svg>',
  pin: '<svg viewBox="0 0 32 32" focusable="false"><path d="M16 28s8-7.5 8-14a8 8 0 1 0-16 0c0 6.5 8 14 8 14Z"/><circle cx="16" cy="14" r="2.5"/></svg>',
  shuttle: '<svg viewBox="0 0 32 32" focusable="false"><path d="M7 10h18v11H7z"/><path d="M10 21v3M22 21v3M10 14h12M11 10l2-4h6l2 4"/><circle cx="11" cy="18" r="1"/><circle cx="21" cy="18" r="1"/></svg>',
  tent: '<svg viewBox="0 0 32 32" focusable="false"><path d="M4 25 16 7l12 18H4Z"/><path d="M16 7v18M16 25l5-8"/></svg>',
  water: '<svg viewBox="0 0 32 32" focusable="false"><path d="M16 5s7 8 7 14a7 7 0 0 1-14 0c0-6 7-14 7-14Z"/><path d="M13 22c2 2 5 2 7-1"/></svg>',
  wave: '<svg viewBox="0 0 32 32" focusable="false"><path d="M5 21c3-3 6 3 10 0s6-3 12-1"/><path d="M5 25c3-3 6 3 10 0s6-3 12-1"/><path d="M20 9c2 4 1 7-3 10"/></svg>'
};
const destinationIconKey = (value) => destinationIconAliases[value] || destinationIconAliases[String(value || '').toLowerCase().replace(/[^a-z0-9]+/g, '_')] || 'neutral';
const iconSvgForKey = (key) => destinationIconSvg[destinationIconKey(key)] || destinationIconSvg.neutral;
const travelIconKeyForItem = (item) => destinationIconKey(item.icon || item.id);
const formatDate = (value) => {
  if (!value) return 'Race day';
  const date = new Date(`${value}T12:00:00Z`);
  return Number.isNaN(date.getTime()) ? value : date.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
};
const raceDateLabel = formatDate(race.event?.date);
const raceLocation = race.event?.location || 'Destination course';
const raceName = race.identity?.name || 'Cascade Marathon';
const raceTagline = race.identity?.tagline || 'The marathon that runs downhill to the sea.';
const privateStatItems = isPrivateMockup ? [
  primaryDistance.distance ? { value: primaryDistance.distance, label: primaryDistance.name || 'Distance' } : null,
  primaryDistance.start_time ? { value: primaryDistance.start_time, label: 'Start time' } : null,
  primaryDistance.price ? { value: primaryDistance.price, label: 'Entry price' } : null,
  primaryDistance.aid_stations ? { value: String(primaryDistance.aid_stations), label: 'Aid stations' } : null
].filter(Boolean) : [];
const hasCertification = Boolean(primaryDistance.certification);
const sourceCourseFacts = [primaryDistance.profile, primaryDistance.certification].filter(Boolean).join(' · ');
const courseTitle = isPrivateMockup ? (race.story?.title || `${raceName} course`) : 'A fast line from the Cascades to the coast.';
const courseLead = isPrivateMockup ? (race.story?.paragraphs?.join(' ') || sourceCourseFacts || raceTagline) : 'Point-to-point, paved end to end, and net downhill the whole way — a true PR-and-qualifier course with the scenery of a destination race. Hover the profile to read any point on the route.';
const courseFeatureItems = isPrivateMockup
  ? [
      primaryDistance.profile ? { iconKey: 'course_profile', title: 'Course profile', text: primaryDistance.profile } : null,
      primaryDistance.aid_stations ? { iconKey: 'aid_support', title: 'Aid support', text: `${primaryDistance.aid_stations} aid stations listed` } : null,
      race.event?.venue ? { iconKey: 'start_finish', title: 'Start venue', text: race.event.venue } : null
    ].filter(Boolean)
  : [
      { iconKey: 'altitude', title: 'Start at altitude', text: 'Gun goes off at 1,180 ft in the Cascade foothills — crisp September air, sunrise over the ridgeline.' },
      { iconKey: 'descent', title: 'Gravity on your side', text: 'A steady, runnable descent through miles 4–18. No quad-shredding drops — graded for fast legal times.' },
      { iconKey: 'coast', title: 'Finish at the Pacific', text: 'The final straight runs onto the boardwalk at Pacific City, the ocean in full view as you cross.' }
    ];
const assetLooksRenderable = (asset) => hasText(asset?.src) && !/\.(pdf|docx?|xlsx?|zip)(\?|#|$)/i.test(asset.src);
const privateImageAssets = Array.isArray(race.private_mockup?.assets)
  ? race.private_mockup.assets.filter(assetLooksRenderable)
  : [];
const customGalleryItems = Array.isArray(race.destination_gallery?.items)
  ? race.destination_gallery.items.filter((item) => item && (hasText(item.src) || hasText(item.visual)) && hasText(item.caption))
  : [];
const assetGalleryItems = privateImageAssets.map((asset) => ({
  type: 'image',
  src: asset.src,
  alt: asset.alt || `${raceName} source image`,
  caption: asset.caption || 'Documented race visual.',
  source: asset.source,
  permission: asset.permission || race.destination_gallery?.asset_policy?.permission_note
}));
const defaultGalleryItems = [
  { visual: 'sunrise', caption: 'Mile 0 · Gun off at first light, 1,180 ft.' },
  { visual: 'descent', caption: 'The descent into mile 8.' },
  { visual: 'pack', caption: 'Lead pack at mile 18.' },
  { visual: 'coast', caption: 'First sight of the Pacific.' },
  { visual: 'finish', caption: 'Pacific City. The finish.' }
];
const privateFallbackGalleryItems = [
  {
    visual: 'ferry',
    caption: 'Bayfield–La Pointe ferry crossing sets the race-weekend clock before runners reach the island.'
  },
  {
    visual: 'beach',
    caption: 'Joni’s Beach anchors packet pickup plus the shared start and finish in La Pointe.'
  },
  {
    visual: 'course-loop',
    caption: `${primaryDistance.name || 'Marathon'} course planning wraps shoreline roads, water stops, and island weather into one weekend.`
  },
  {
    visual: 'lodging',
    caption: 'Lodging and camping decisions are part of the destination plan, not an afterthought.'
  },
  {
    visual: 'finish',
    caption: 'Post-race celebrations stay close to the ferry landing and Joni’s Beach event tent.'
  }
];
const destinationGalleryItems = isPrivateMockup
  ? (customGalleryItems.length ? customGalleryItems : [...assetGalleryItems, ...privateFallbackGalleryItems]).slice(0, 5)
  : defaultGalleryItems;
const galleryLead = isPrivateMockup
  ? (race.destination_gallery?.intro || race.story?.paragraphs?.[0] || raceTagline)
  : 'From the gun in the Cascade foothills to the boardwalk at Pacific City — three hours of running through some of the most photographed terrain on the West Coast.';
const galleryHeadline = isPrivateMockup ? (race.destination_gallery?.headline || 'What the island weekend looks like.') : 'What the day looks like.';
const galleryNote = isPrivateMockup
  ? (race.destination_gallery?.asset_policy?.display_note || 'Race visuals combine documented race imagery with Madeline Island-specific editorial fallback art for review.')
  : 'Race visuals highlight the destination experience.';
const hasDocumentedGalleryScenes = destinationGalleryItems.some((item) => hasText(item.source));
const gallerySvgForVisual = (visual = 'sunrise') => ({
  sunrise: `<svg viewBox="0 0 400 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><circle cx="200" cy="240" r="130" fill="#FFE7B8" opacity=".18"/><circle cx="200" cy="240" r="80" fill="#FFE7B8" opacity=".45"/><circle cx="200" cy="240" r="55" fill="#FFEFC8" opacity=".85"/><path d="M0 380 L80 330 L160 360 L240 310 L320 350 L400 320 L400 600 L0 600Z" fill="#5A2A40" opacity=".55"/><path d="M0 450 L70 405 L150 430 L230 380 L310 415 L400 395 L400 600 L0 600Z" fill="#3A1A2D" opacity=".75"/><path d="M0 520 L90 475 L180 500 L270 450 L360 480 L400 470 L400 600 L0 600Z" fill="#1A0E18"/></svg>`,
  descent: `<svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><ellipse cx="200" cy="100" rx="150" ry="40" fill="#5CB89D" opacity=".18"/><path d="M0 170 L70 145 L140 160 L210 138 L280 152 L350 142 L400 155 L400 300 L0 300Z" fill="#0F2B23" opacity=".7"/><path d="M0 215 L80 188 L160 205 L240 182 L320 200 L400 192 L400 300 L0 300Z" fill="#06140F"/></svg>`,
  pack: `<svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><rect x="0" y="130" width="400" height="50" fill="#7E5C9C" opacity=".25"/><ellipse cx="320" cy="155" rx="180" ry="25" fill="#A881C4" opacity=".3"/><path d="M0 200 L80 180 L160 195 L240 175 L320 188 L400 182 L400 300 L0 300Z" fill="#0A0E1F" opacity=".88"/></svg>`,
  coast: `<svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><ellipse cx="200" cy="80" rx="180" ry="40" fill="#A8DCE8" opacity=".25"/><line x1="0" y1="158" x2="400" y2="158" stroke="#1F5A6E" stroke-width="1" opacity=".55"/><ellipse cx="200" cy="170" rx="12" ry="55" fill="#FFEFC8" opacity=".2"/><ellipse cx="200" cy="170" rx="5" ry="40" fill="#FFEFC8" opacity=".7"/></svg>`,
  finish: `<svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><ellipse cx="200" cy="200" rx="200" ry="60" fill="#FFD79B" opacity=".3"/><rect x="0" y="128" width="400" height="22" fill="#FFEFC8" opacity=".88"/><rect x="0" y="148" width="400" height="3" fill="#F0A94B"/></svg>`,
  ferry: `<svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><path d="M0 0h400v300H0z" fill="#0d3343"/><circle cx="315" cy="70" r="42" fill="#ffd79b" opacity=".75"/><path d="M0 125h400v175H0z" fill="#1d6a82"/><path d="M0 170c55-18 96 17 148 0s94-18 148 0 78 18 104 5v125H0z" fill="#0c2434" opacity=".62"/><path d="M92 130h172l-28 54H116z" fill="#f6f2ea"/><path d="M128 102h82v30h-82z" fill="#f0a94b"/><path d="M112 184h150" stroke="#ff5b2e" stroke-width="6"/></svg>`,
  beach: `<svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><path d="M0 0h400v300H0z" fill="#102f34"/><path d="M0 128c82 22 130-20 206 0 84 22 120-14 194 2v170H0z" fill="#e2bc7b"/><path d="M0 158c70 24 140-12 210 8 84 24 126-11 190 6v128H0z" fill="#f6f2ea" opacity=".5"/><path d="M66 95h92v58H66z" fill="#ff5b2e"/><path d="M78 153h68" stroke="#0b0e13" stroke-width="6"/><path d="M220 92l38 68h-76z" fill="#f0a94b" opacity=".9"/></svg>`,
  'course-loop': `<svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><path d="M0 0h400v300H0z" fill="#173c31"/><path d="M206 20c86 28 138 94 123 162-17 78-110 111-196 82C55 238 29 164 58 104 86 45 132-4 206 20z" fill="#f6f2ea" opacity=".12"/><path d="M214 52c65 20 102 68 92 118-11 58-80 82-145 61-58-19-78-74-57-119 20-43 56-76 110-60z" fill="none" stroke="#ff5b2e" stroke-width="12" stroke-linecap="round"/><circle cx="101" cy="127" r="10" fill="#ffd79b"/><circle cx="306" cy="168" r="10" fill="#ffd79b"/><path d="M0 239c88-26 143 17 222-1 74-17 115-28 178 4v58H0z" fill="#0b2a23"/></svg>`,
  lodging: `<svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><path d="M0 0h400v300H0z" fill="#1b2433"/><circle cx="310" cy="72" r="42" fill="#ffe7b8" opacity=".7"/><path d="M0 220 L80 160 L142 194 L210 122 L282 188 L350 138 L400 174 L400 300 L0 300z" fill="#0b0e13"/><path d="M118 146h112v92H118z" fill="#f6f2ea"/><path d="M104 150l70-52 72 52z" fill="#ff5b2e"/><rect x="144" y="176" width="22" height="28" fill="#0d3343"/><rect x="184" y="176" width="22" height="28" fill="#0d3343"/></svg>`
}[visual] || gallerySvgForVisual('sunrise'));
---

<!-- NAV -->
<nav id="nav">
  <a href="#top" class="brand">
    <svg class="mark" viewBox="0 0 40 40" fill="none"><path d="M2 32 14 10l7 12 5-8 12 18z" fill="#FF5B2E"/><path d="M2 32 14 10l4.5 7.7L9 32z" fill="#F0A94B"/></svg>
    <span>{raceName}<small>{race.identity?.edition || 'Marathon'}</small></span>
  </a>
  <div class="nav-links" id="navLinks">
    <a href="#course">Course</a>
    <a href="#raceday">Race Day</a>
    {!isPrivateMockup && hasCertification && <a href="#qualify">Qualify</a>}
    <a href="#entry">Entry</a>
    <a href="#weekend">Weekend</a>
    {hasTravelLogistics && <a href="#travel">Travel</a>}
    <a href="#faq">FAQ</a>
    <a class="btn btn-accent" href={registrationUrl} {...registerAttrs('nav-button')}>{registrationLabel}</a>
  </div>
  <button class="hamburger" id="burger" aria-label="Menu"><span></span><span></span><span></span></button>
</nav>

<!-- HERO -->
<header class="hero" id="top">
  <div class="sky"></div>
  <div class="sun"></div>

  <div class="ridge r4"><svg viewBox="0 0 1440 200" preserveAspectRatio="none"><path d="M0 200 L0 120 L160 60 L320 110 L520 30 L700 100 L900 45 L1120 105 L1280 55 L1440 110 L1440 200Z" fill="#241B30"/></svg></div>
  <div class="ridge r3"><svg viewBox="0 0 1440 200" preserveAspectRatio="none"><path d="M0 200 L0 140 L200 70 L380 130 L560 55 L760 120 L980 60 L1180 125 L1360 70 L1440 110 L1440 200Z" fill="#1B2433"/></svg></div>
  <div class="ridge r2"><svg viewBox="0 0 1440 200" preserveAspectRatio="none"><path d="M0 200 L0 150 L180 95 L420 150 L640 80 L880 145 L1100 90 L1320 150 L1440 120 L1440 200Z" fill="#121A27"/></svg></div>
  <div class="ridge r1"><svg viewBox="0 0 1440 220" preserveAspectRatio="none"><path d="M0 220 L0 170 L240 120 L480 175 L720 110 L960 175 L1200 125 L1440 170 L1440 220Z" fill="#0B0E13"/></svg></div>
  <div class="haze"></div>

  <div class="hero-inner">
    <span class="eyebrow">{isPrivateMockup ? 'Destination race guide' : 'Abbott-track candidate · Pacific Northwest'}</span>
    <h1>{raceName}<span class="thin">{raceTagline}</span></h1>
    <div class="hero-meta">
      <span><span class="dot">●</span> {raceDateLabel}</span>
      <span><span class="dot">●</span> {raceLocation}</span>
      <span><span class="dot">●</span> {primaryDistance.distance || '26.2 miles'}{primaryDistance.profile ? ` · ${primaryDistance.profile}` : ' · net downhill'}</span>
    </div>

    {registrationStatusCopy && (
      <div class={`registration-status-pill status-${registrationStatusCopy.status}`} data-registration-status>
        <strong>{registrationStatusCopy.label}</strong>
        {registrationStatusCopy.detail && <span>{registrationStatusCopy.detail}</span>}
      </div>
    )}

    <div class="hero-cta">
      <a class="btn btn-accent" href={registrationUrl} {...registerAttrs('hero-primary')}>{registrationLabel} →</a>
      {hasRunnerChecklist ? <button class="btn btn-ghost" onclick="scrollToId('runner-checklist')">Review key race details</button> : <button class="btn btn-ghost" onclick="scrollToId('course')">Explore the Course</button>}
    </div>
  </div>

  <div class="scrollcue"><span>Scroll</span><span class="line"></span></div>
</header>

<!-- STAT BAR -->
<div class="statbar">
  <div class="statbar-grid stagger" id="statbar">
    {isPrivateMockup ? privateStatItems.map((item) => <div class="stat"><div class="n">{item.value}</div><div class="l">{item.label}</div></div>) : (
      <>
        <div class="stat"><div class="n">12,000</div><div class="l">Runners</div></div>
        <div class="stat"><div class="n">−948 ft</div><div class="l">Net Drop</div></div>
        <div class="stat"><div class="n">58%</div><div class="l">BQ Rate '25</div></div>
        <div class="stat"><div class="n">41</div><div class="l">Countries</div></div>
        <div class="stat"><div class="n">$2.1M</div><div class="l">Raised for Charity</div></div>
      </>
    )}
  </div>
</div>

{isPrivateMockup && (
  <section class="private-value major-private" aria-labelledby="private-value-title" data-private-value-narrative>
    <div class="wrap private-grid">
      <div>
        <div class="kicker">Runner race guide</div>
        <h2 class="sec-title" id="private-value-title">{privateValue.headline}</h2>
      </div>
      <div class="private-panel">
        <p>{privateValue.intro}</p>
        <ul>
          {privateValue.improved.slice(0, 4).map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>
)}

{hasRunnerChecklist && (
  <section id="runner-checklist" class="runner-checklist major-private" aria-labelledby="runner-checklist-title" data-runner-decision-checklist>
    <div class="wrap">
      <div class="private-section-head">
        <div>
          <div class="kicker">Before runners commit</div>
          <h2 class="sec-title" id="runner-checklist-title">{race.runner_decision_checklist?.headline || 'Runner decision checklist'}</h2>
        </div>
        <a class="btn btn-accent" href={registrationUrl} {...registerAttrs('runner-checklist-top')}>{registrationLabel}</a>
      </div>
      <p class="lead">{race.runner_decision_checklist?.intro || 'Key facts a runner needs before continuing to the official registration page.'}</p>
      <div class="checklist-grid">
        {checklistItems.map((item) => (
          <article class="check-card reveal" data-checklist-item-id={item.id}>
            <span>{item.label}</span>
            <strong>{item.value}</strong>
            {item.detail && <p>{item.detail}</p>}
          </article>
        ))}
      </div>
      <div class="checklist-footer">
        <span>Review the race details here, then continue to {platformLabel} when you are ready.</span>
        <a class="btn btn-accent" href={registrationUrl} {...registerAttrs('runner-checklist-footer')}>Continue to registration</a>
      </div>
    </div>
  </section>
)}

{isPrivateMockup && (
  <section class="registration-decision major-private" aria-labelledby="registration-decision-title" data-registration-decision-card>
    <div class="wrap decision-wrap">
      <div>

---
import { registerClickAttributes } from "../../../shared/analytics/register-click.mjs";
import { registrationPlatformLabel } from "../../../shared/registration-platform-label.mjs";
import { shouldRenderTrustSignalsBand, trustSignalsForRace } from "../../../shared/private-mockup-trust.mjs";
import { measurementReadyCopyForRace, privateValueNarrativeForRace, registrationDecisionCopyForRace } from "../../../shared/private-mockup-value.mjs";

const { race } = Astro.props;
const isPrivateMockup = Boolean(race.private_mockup);
const registrationUrl = race.registration?.url || '#entry';
const registrationLabel = race.registration?.cta_label || 'Register now';
const platformLabel = registrationPlatformLabel(race.registration?.platform);
const privateValue = privateValueNarrativeForRace(race, {
  headline: 'A premium race story with the registration path pulled into focus.',
  intro: 'This preview keeps the cinematic destination race language while making runner decisions, trust signals, and registration clicks easier to see.',
  improved: [
    'Clear race details sit before registration decisions.',
    'Registration calls-to-action use distinct measurement-ready placements.',
    'Preview proof modules stay out of the public destination preview.'
  ]
});
const registrationDecisionCopy = registrationDecisionCopyForRace(race, {
  kicker: 'Registration decision',
  headline: 'Make the next step unmistakable.',
  body: 'Runners stay in the destination experience until they are ready to move to the official registration provider.'
});
const measurementCopy = measurementReadyCopyForRace(race, {
  headline: 'Every registration click has a clean placement.',
  intro: 'This page prepares registration click intent and platform metadata without claiming completed registration outcomes.'
});
const registerAttrs = (placement) => registerClickAttributes(race, placement);
const checklistItems = Array.isArray(race.runner_decision_checklist?.items) ? race.runner_decision_checklist.items : [];
const hasRunnerChecklist = isPrivateMockup && checklistItems.length > 0;
const trustSignals = trustSignalsForRace(race);
const showTrustSignalsBand = isPrivateMockup && shouldRenderTrustSignalsBand(race);
const primaryDistance = race.distances?.find((distance) => distance.featured) || race.distances?.[0] || {};
const entryTiers = (race.distances?.length ? race.distances : [primaryDistance]).filter(Boolean);
const scheduleItems = Array.isArray(race.schedule) ? race.schedule : [];
const faqItems = Array.isArray(race.faqs) ? race.faqs : [];
const formatDate = (value) => {
  if (!value) return 'Race day';
  const date = new Date(`${value}T12:00:00Z`);
  return Number.isNaN(date.getTime()) ? value : date.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
};
const raceDateLabel = formatDate(race.event?.date);
const raceLocation = race.event?.location || 'Destination course';
const raceName = race.identity?.name || 'Cascade Marathon';
const raceTagline = race.identity?.tagline || 'The marathon that runs downhill to the sea.';
const privateStatItems = isPrivateMockup ? [
  primaryDistance.distance ? { value: primaryDistance.distance, label: primaryDistance.name || 'Distance' } : null,
  primaryDistance.start_time ? { value: primaryDistance.start_time, label: 'Start time' } : null,
  primaryDistance.price ? { value: primaryDistance.price, label: 'Entry price' } : null,
  primaryDistance.aid_stations ? { value: String(primaryDistance.aid_stations), label: 'Aid stations' } : null,
  primaryDistance.certification ? { value: primaryDistance.certification, label: 'Certification' } : null
].filter(Boolean) : [];
const hasCertification = Boolean(primaryDistance.certification);
const sourceCourseFacts = [primaryDistance.profile, primaryDistance.certification].filter(Boolean).join(' · ');
const courseTitle = isPrivateMockup ? (race.story?.title || `${raceName} course`) : 'A fast line from the Cascades to the coast.';
const courseLead = isPrivateMockup ? (race.story?.paragraphs?.join(' ') || sourceCourseFacts || raceTagline) : 'Point-to-point, paved end to end, and net downhill the whole way — a true PR-and-qualifier course with the scenery of a destination race. Hover the profile to read any point on the route.';
const courseFeatureItems = isPrivateMockup
  ? [
      primaryDistance.profile ? { icon: '🗺️', title: 'Course profile', text: primaryDistance.profile } : null,
      primaryDistance.aid_stations ? { icon: '💧', title: 'Aid support', text: `${primaryDistance.aid_stations} aid stations listed` } : null,
      race.event?.venue ? { icon: '📍', title: 'Start venue', text: race.event.venue } : null
    ].filter(Boolean)
  : [
      { icon: '⛰️', title: 'Start at altitude', text: 'Gun goes off at 1,180 ft in the Cascade foothills — crisp September air, sunrise over the ridgeline.' },
      { icon: '📉', title: 'Gravity on your side', text: 'A steady, runnable descent through miles 4–18. No quad-shredding drops — graded for fast legal times.' },
      { icon: '🌊', title: 'Finish at the Pacific', text: 'The final straight runs onto the boardwalk at Pacific City, the ocean in full view as you cross.' }
    ];
const galleryLead = isPrivateMockup ? (race.story?.paragraphs?.[0] || raceTagline) : 'From the gun in the Cascade foothills to the boardwalk at Pacific City — three hours of running through some of the most photographed terrain on the West Coast.';
const privateEntryPlacements = entryTiers.map((tier) => `entry-distance-${tier.id || 'primary'}`);
const measurementPlacements = [
  'nav-button',
  'hero-primary',
  ...(hasRunnerChecklist ? ['runner-checklist-top', 'runner-checklist-footer'] : []),
  'registration-decision-card',
  ...(isPrivateMockup ? privateEntryPlacements : [`entry-distance-${primaryDistance.id || 'ballot'}`, 'entry-guaranteed', 'entry-charity']),
  'finale-primary'
];
const parseStartTime = (value) => {
  const match = String(value || '').trim().match(/^(\d{1,2})(?::(\d{2}))?\s*(AM|PM)?$/i);
  if (!match) return '00:00:00';
  let hour = Number(match[1]);
  const minute = match[2] || '00';
  const meridiem = match[3]?.toUpperCase();
  if (meridiem === 'PM' && hour < 12) hour += 12;
  if (meridiem === 'AM' && hour === 12) hour = 0;
  return `${String(hour).padStart(2, '0')}:${minute}:00`;
};
const countdownIso = `${race.event?.date || '2026-09-20'}T${parseStartTime(primaryDistance.start_time || '6:45 AM')}-07:00`;
---

<!-- NAV -->
<nav id="nav">
  <a href="#top" class="brand">
    <svg class="mark" viewBox="0 0 40 40" fill="none"><path d="M2 32 14 10l7 12 5-8 12 18z" fill="#FF5B2E"/><path d="M2 32 14 10l4.5 7.7L9 32z" fill="#F0A94B"/></svg>
    <span>{raceName}<small>{race.identity?.edition || 'Marathon'}</small></span>
  </a>
  <div class="nav-links" id="navLinks">
    <a href="#course">Course</a>
    <a href="#raceday">Race Day</a>
    {(!isPrivateMockup || hasCertification) && <a href="#qualify">Qualify</a>}
    <a href="#entry">Entry</a>
    <a href="#weekend">Weekend</a>
    {!isPrivateMockup && <a href="#travel">Travel</a>}
    <a href="#faq">FAQ</a>
    <a class="btn btn-accent" href={registrationUrl} {...registerAttrs('nav-button')}>{registrationLabel}</a>
  </div>
  <button class="hamburger" id="burger" aria-label="Menu"><span></span><span></span><span></span></button>
</nav>

<!-- HERO -->
<header class="hero" id="top">
  <div class="sky"></div>
  <div class="sun"></div>

  <div class="ridge r4"><svg viewBox="0 0 1440 200" preserveAspectRatio="none"><path d="M0 200 L0 120 L160 60 L320 110 L520 30 L700 100 L900 45 L1120 105 L1280 55 L1440 110 L1440 200Z" fill="#241B30"/></svg></div>
  <div class="ridge r3"><svg viewBox="0 0 1440 200" preserveAspectRatio="none"><path d="M0 200 L0 140 L200 70 L380 130 L560 55 L760 120 L980 60 L1180 125 L1360 70 L1440 110 L1440 200Z" fill="#1B2433"/></svg></div>
  <div class="ridge r2"><svg viewBox="0 0 1440 200" preserveAspectRatio="none"><path d="M0 200 L0 150 L180 95 L420 150 L640 80 L880 145 L1100 90 L1320 150 L1440 120 L1440 200Z" fill="#121A27"/></svg></div>
  <div class="ridge r1"><svg viewBox="0 0 1440 220" preserveAspectRatio="none"><path d="M0 220 L0 170 L240 120 L480 175 L720 110 L960 175 L1200 125 L1440 170 L1440 220Z" fill="#0B0E13"/></svg></div>
  <div class="haze"></div>

  <div class="hero-inner">
    <span class="eyebrow">{isPrivateMockup ? 'Race website preview · destination major' : 'Abbott-track candidate · Pacific Northwest'}</span>
    <h1>{raceName}<span class="thin">{raceTagline}</span></h1>
    <div class="hero-meta">
      <span><span class="dot">●</span> {raceDateLabel}</span>
      <span><span class="dot">●</span> {raceLocation}</span>
      <span><span class="dot">●</span> {primaryDistance.distance || '26.2 miles'}{primaryDistance.profile ? ` · ${primaryDistance.profile}` : ' · net downhill'}</span>
    </div>

    <div class="countdown" id="countdown" aria-label="Countdown to race day">
<div class="cd-unit"><div class="cd-num" id="cd-d">--</div><div class="cd-lab">Days</div></div>
      <div class="cd-unit"><div class="cd-num" id="cd-h">--</div><div class="cd-lab">Hours</div></div>
      <div class="cd-unit"><div class="cd-num" id="cd-m">--</div><div class="cd-lab">Minutes</div></div>
      <div class="cd-unit"><div class="cd-num" id="cd-s">--</div><div class="cd-lab">Seconds</div></div>
    </div>

    <div class="hero-cta">
      <a class="btn btn-accent" href={registrationUrl} {...registerAttrs('hero-primary')}>{registrationLabel} →</a>
      {hasRunnerChecklist ? <button class="btn btn-ghost" onclick="scrollToId('runner-checklist')">Review key race details</button> : <button class="btn btn-ghost" onclick="scrollToId('course')">Explore the Course</button>}
    </div>
  </div>

  <div class="scrollcue"><span>Scroll</span><span class="line"></span></div>
</header>

<!-- STAT BAR -->
<div class="statbar">
  <div class="statbar-grid stagger" id="statbar">
    {isPrivateMockup ? privateStatItems.map((item) => <div class="stat"><div class="n">{item.value}</div><div class="l">{item.label}</div></div>) : (
      <>
        <div class="stat"><div class="n">12,000</div><div class="l">Runners</div></div>
        <div class="stat"><div class="n">−948 ft</div><div class="l">Net Drop</div></div>
        <div class="stat"><div class="n">58%</div><div class="l">BQ Rate '25</div></div>
        <div class="stat"><div class="n">41</div><div class="l">Countries</div></div>
        <div class="stat"><div class="n">$2.1M</div><div class="l">Raised for Charity</div></div>
      </>
    )}
  </div>
</div>

{isPrivateMockup && (
  <section class="private-value major-private" data-private-value-narrative>
    <div class="wrap private-grid">
      <div>
        <div class="kicker">Race website preview</div>
        <h2 class="sec-title">{privateValue.headline}</h2>
      </div>
      <div class="private-panel">
        <p>{privateValue.intro}</p>
        <ul>
          {privateValue.improved.slice(0, 4).map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>
)}

{hasRunnerChecklist && (
  <section id="runner-checklist" class="runner-checklist major-private" data-runner-decision-checklist>
    <div class="wrap">
      <div class="private-section-head">
        <div>
          <div class="kicker">Before runners commit</div>
          <h2 class="sec-title">{race.runner_decision_checklist?.headline || 'Runner decision checklist'}</h2>
        </div>
        <a class="btn btn-accent" href={registrationUrl} {...registerAttrs('runner-checklist-top')}>{registrationLabel}</a>
      </div>
      <p class="lead">{race.runner_decision_checklist?.intro || 'Key facts a runner needs before continuing to the official registration handoff.'}</p>
      <div class="checklist-grid">
        {checklistItems.map((item) => (
          <article class="check-card reveal" data-checklist-item-id={item.id}>
            <span>{item.label}</span>
            <strong>{item.value}</strong>
            {item.detail && <p>{item.detail}</p>}
          </article>
        ))}
      </div>
      <div class="checklist-footer">
        <span>Registration continues on {platformLabel}; this preview tracks the click-through path only.</span>
        <a class="btn btn-dark" href={registrationUrl} {...registerAttrs('runner-checklist-footer')}>Continue to registration</a>
      </div>
    </div>
  </section>
)}

{isPrivateMockup && (
  <section class="registration-decision major-private" data-registration-decision-card>
    <div class="wrap decision-wrap">
      <div>
        <div class="kicker">{registrationDecisionCopy.kicker}</div>
        <h2 class="sec-title">{registrationDecisionCopy.headline}</h2>
      </div>
      <div class="decision-card">
        <p>{registrationDecisionCopy.body}</p>
        <dl>
          <div><dt>Official handoff</dt><dd>{platformLabel}</dd></div>
          <div><dt>Primary CTA</dt><dd>{registrationLabel}</dd></div>
          <div><dt>Measurement</dt><dd>Registration click intent by placement</dd></div>
        </dl>
        <a class="btn btn-accent" href={registrationUrl} {...registerAttrs('registration-decision-card')}>Continue to official registration</a>
      </div>
    </div>
  </section>
)}

{showTrustSignalsBand && (
  <section class="trust-band major-private" data-trust-signals-band>
    <div class="wrap">
      <div class="kicker">Runner trust signals</div>
      <div class="trust-grid">
        {trustSignals.map((signal) => (
          <article>
            <span>{signal.label}</span>
            <strong>{signal.value}</strong>
            {signal.detail && <p>{signal.detail}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<!-- COURSE -->
<section class="course" id="course">
  <div class="wrap">
    <div class="course-head">
      <div class="reveal">
        <div class="kicker">The Course</div>
        <h2 class="sec-title">{courseTitle}</h2>
      </div>
      <p class="lead reveal">{courseLead}</p>
    </div>

    {!isPrivateMockup && <div class="elev-card reveal">
      <div class="elev-top">
        <h3>Elevation Profile</h3>
        <div class="elev-readout">Mile <b id="elMile">0.0</b> &nbsp;·&nbsp; <span id="elElev">1,180</span> ft</div>
      </div>
      <div class="elev-wrap">
        <svg id="elevSvg" viewBox="0 0 1000 240" preserveAspectRatio="none">
          <defs>
            <linearGradient id="elevFill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#FF5B2E" stop-opacity=".55"/>
              <stop offset="100%" stop-color="#FF5B2E" stop-opacity="0"/>
            </linearGradient>
          </defs>
          <g id="gridLines"></g>
          <path id="elevArea" fill="url(#elevFill)"/>
          <path id="elevLine" fill="none" stroke="#FF5B2E" stroke-width="2.5" stroke-linejoin="round"/>
          <line class="elev-cursor" id="elCursor" y1="0" y2="240"/>
          <circle class="elev-dot" id="elDot" r="5"/>
        </svg>
      </div>
    </div>}

    <div class="course-feats stagger" id="courseFeats">
      {courseFeatureItems.map((feature) => <div class="feat"><div class="ic">{feature.icon}</div><h3>{feature.title}</h3><p>{feature.text}</p></div>)}
    </div>
  </div>
</section>

<!-- RACE DAY GALLERY -->
<section class="gallery" id="raceday">
  <div class="wrap">
    <div class="gal-head">
      <div class="reveal">
        <div class="kicker">Race Day</div>
        <h2 class="sec-title">What the day looks like.</h2>
      </div>
      <p class="lead reveal">{galleryLead}</p>
    </div>

    <div class="gallery-grid reveal">
      <figure class="g-photo g-1">
        <div class="ph-img ph-sunrise">
          <svg viewBox="0 0 400 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
<circle cx="200" cy="240" r="130" fill="#FFE7B8" opacity=".18"/>
            <circle cx="200" cy="240" r="80" fill="#FFE7B8" opacity=".45"/>
            <circle cx="200" cy="240" r="55" fill="#FFEFC8" opacity=".85"/>
            <path d="M0 380 L80 330 L160 360 L240 310 L320 350 L400 320 L400 600 L0 600Z" fill="#5A2A40" opacity=".55"/>
            <path d="M0 450 L70 405 L150 430 L230 380 L310 415 L400 395 L400 600 L0 600Z" fill="#3A1A2D" opacity=".75"/>
            <path d="M0 520 L90 475 L180 500 L270 450 L360 480 L400 470 L400 600 L0 600Z" fill="#1A0E18"/>
          </svg>
        </div>
        <figcaption>{isPrivateMockup ? `${primaryDistance.name || 'Race'} start` : 'Mile 0 · Gun off at first light, 1,180 ft.'}</figcaption>
      </figure>
      <figure class="g-photo g-2">
        <div class="ph-img ph-descent">
          <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <ellipse cx="200" cy="100" rx="150" ry="40" fill="#5CB89D" opacity=".18"/>
            <path d="M0 170 L70 145 L140 160 L210 138 L280 152 L350 142 L400 155 L400 300 L0 300Z" fill="#0F2B23" opacity=".7"/>
            <path d="M0 215 L80 188 L160 205 L240 182 L320 200 L400 192 L400 300 L0 300Z" fill="#06140F"/>
          </svg>
        </div>
        <figcaption>{isPrivateMockup ? (primaryDistance.profile || 'Course profile') : 'The descent into mile 8.'}</figcaption>
      </figure>
      <figure class="g-photo g-3">
        <div class="ph-img ph-pack">
          <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <rect x="0" y="130" width="400" height="50" fill="#7E5C9C" opacity=".25"/>
            <ellipse cx="320" cy="155" rx="180" ry="25" fill="#A881C4" opacity=".3"/>
            <path d="M0 200 L80 180 L160 195 L240 175 L320 188 L400 182 L400 300 L0 300Z" fill="#0A0E1F" opacity=".88"/>
          </svg>
        </div>
        <figcaption>{isPrivateMockup ? (primaryDistance.distance || 'Race distance') : 'Lead pack at mile 18.'}</figcaption>
      </figure>
      <figure class="g-photo g-4">
        <div class="ph-img ph-coast">
          <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <ellipse cx="200" cy="80" rx="180" ry="40" fill="#A8DCE8" opacity=".25"/>
            <line x1="0" y1="158" x2="400" y2="158" stroke="#1F5A6E" stroke-width="1" opacity=".55"/>
            <ellipse cx="200" cy="170" rx="12" ry="55" fill="#FFEFC8" opacity=".2"/>
            <ellipse cx="200" cy="170" rx="5" ry="40" fill="#FFEFC8" opacity=".7"/>
          </svg>
        </div>
        <figcaption>{isPrivateMockup ? raceLocation : 'First sight of the Pacific.'}</figcaption>
      </figure>
      <figure class="g-photo g-5">
        <div class="ph-img ph-finish">
          <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <ellipse cx="200" cy="200" rx="200" ry="60" fill="#FFD79B" opacity=".3"/>
            <rect x="0" y="128" width="400" height="22" fill="#FFEFC8" opacity=".88"/>
            <rect x="0" y="148" width="400" height="3" fill="#F0A94B"/>
          </svg>
        </div>
        <figcaption>{isPrivateMockup ? 'Finish experience' : 'Pacific City. The finish.'}</figcaption>
      </figure>
    </div>

    <p class="gallery-note reveal">Concept visuals — race photography swaps in before launch.</p>
  </div>
</section>

<!-- QUALIFYING -->
{(!isPrivateMockup || hasCertification) && <section class="bq" id="qualify">
  <div class="wrap">
    <div class="reveal">
      <div class="kicker">Boston Qualifying</div>
      <h2 class="sec-title">{isPrivateMockup ? 'Course certification on the page.' : 'Built so your time actually counts.'}</h2>
    </div>
    <p class="lead reveal">{isPrivateMockup ? primaryDistance.certification : "Cascade is USATF-certified (course #OR-26-CASCADE) and a Boston Marathon qualifying race. Run your number here and you'll have a verified result that the B.A.A. accepts."}</p>

    <div class="bq-grid">
      <div class="bq-note reveal">
        <h3>{isPrivateMockup ? 'Course facts' : 'Why runners chase a BQ here'}</h3>
        {isPrivateMockup ? <p>{sourceCourseFacts}</p> : <><p>The net-downhill profile plays to even-paced running, the September date sits in the sweet spot of fall fitness, and the small, fast field means clean lines from gun to tape.</p><p>Live, chip-verified splits post to your B.A.A.-ready certificate within 24 hours of finishing — no waiting, no manual submission.</p></>}
        <span class="bq-badge">✓ {isPrivateMockup ? 'Course certification listed' : 'B.A.A. Qualifier · Certified Course'}</span>
      </div>

      {!isPrivateMockup && <div class="reveal">
        <table class="bq-table">
          <thead><tr><th>Age Group</th><th>Men</th><th>Women</th></tr></thead>
          <tbody>
            <tr><td>18–34</td><td class="t">2:55:00</td><td class="t">3:25:00</td></tr>
            <tr><td>35–39</td><td class="t">3:00:00</td><td class="t">3:30:00</td></tr>
            <tr><td>40–44</td><td class="t">3:05:00</td><td class="t">3:35:00</td></tr>
            <tr><td>45–49</td><td class="t">3:15:00</td><td class="t">3:45:00</td></tr>
            <tr><td>50–54</td><td class="t">3:20:00</td><td class="t">3:50:00</td></tr>
            <tr><td>55–59</td><td class="t">3:30:00</td><td class="t">4:00:00</td></tr>
            <tr><td>60–64</td><td class="t">3:50:00</td><td class="t">4:20:00</td></tr>
            <tr><td>65–69</td><td class="t">4:05:00</td><td class="t">4:35:00</td></tr>
            <tr><td>70+</td><td class="t">4:20:00</td><td class="t">4:50:00</td></tr>
          </tbody>
        </table>
      </div>}
    </div>
  </div>
</section>}

<!-- ENTRY -->
<section id="entry">
  <div class="wrap">
    <div class="reveal">
      <div class="kicker">Secure Your Place</div>
      <h2 class="sec-title">{isPrivateMockup ? 'Registration options for race day.' : 'Three ways through the start line.'}</h2>
    </div>

    <div class="entry-grid">
      {isPrivateMockup ? entryTiers.map((tier) => <div class="tier reveal">
        <h3>{tier.name || 'Race entry'}</h3>
        {tier.start_time && <div class="sub">Start time: {tier.start_time}</div>}
        {tier.price && <div class="tprice">{tier.price}<span>/ entry</span></div>}
        <ul>
          {tier.distance && <li>{tier.distance}</li>}
          {tier.profile && <li>{tier.profile}</li>}
          {tier.certification && <li>{tier.certification}</li>}
          {tier.aid_stations && <li>{tier.aid_stations} aid stations listed</li>}
        </ul>
        <a class="btn btn-dark" href={registrationUrl} {...registerAttrs(`entry-distance-${tier.id || 'primary'}`)}>{registrationLabel}</a>
      </div>) : <>
        <div class="tier reveal">
          <h3>Ballot</h3>
          <div class="sub">Open Sept 1 – Oct 15, 2025</div>
          <div class="tprice">$185<span>/ entry</span></div>
          <ul>
            <li>Randomized draw, results in November</li>
            <li>Full refund if not drawn</li>
            <li>Technical race tee + finisher medal</li>
            <li>Chip timing & B.A.A. certificate</li>
          </ul>
          <a class="btn btn-dark" href={registrationUrl} {...registerAttrs(`entry-distance-${primaryDistance.id || 'ballot'}`)}>Enter the Ballot</a>
        </div>

        <div class="tier featured reveal">
          <span class="tier-tag">Most Popular</span>
          <h3>Guaranteed</h3>
          <div class="sub">For runners with a recent qualifying time</div>
          <div class="tprice">$245<span>/ entry</span></div>
          <ul>
            <li>Skip the draw — instant confirmation</li>
            <li>Sub-3:30 proof from the last 24 months</li>
            <li>Preferred corral placement</li>
            <li>Premium kit + expo fast-track</li>
            <li>Reserved gear-check & start village</li>
          </ul>
          <a class="btn btn-accent" href={registrationUrl} {...registerAttrs('entry-guaranteed')}>Claim Guaranteed Spot</a>
        </div>

        <div class="tier reveal">
          <h3>Charity</h3>

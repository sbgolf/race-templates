<script is:inline>
  // ---- smooth scroll helper ----
  function scrollToId(id){document.getElementById(id).scrollIntoView({behavior:'smooth',block:'start'});closeMenu();}

  // ---- nav scroll state ----
  const nav=document.getElementById('nav');
  addEventListener('scroll',()=>nav.classList.toggle('scrolled',scrollY>40));

  // ---- mobile menu ----
  const burger=document.getElementById('burger'),navLinks=document.getElementById('navLinks');
  function closeMenu(){navLinks.classList.remove('open')}
  burger.addEventListener('click',()=>navLinks.classList.toggle('open'));
  navLinks.querySelectorAll('a').forEach(a=>a.addEventListener('click',closeMenu));

  // ---- elevation profile ----
  if(document.getElementById('elevSvg')){
  // [mile, elevation ft] — net downhill from 1180 to ~30
  const pts=[[0,1180],[2,1130],[4,1090],[6,980],[8,870],[10,760],[12,690],[14,640],[16,560],[18,470],[19,520],[20,440],[22,300],[24,180],[25,90],[26.2,30]];
  const MAXM=26.2, W=1000, H=240, PADT=18, PADB=16;
  const elev=pts.map(p=>p[1]), maxE=Math.max(...elev), minE=Math.min(...elev);
  const x=m=>m/MAXM*W;
  const y=e=>PADT+(1-(e-minE)/(maxE-minE))*(H-PADT-PADB);
  let dLine='M'+pts.map(p=>x(p[0]).toFixed(1)+' '+y(p[1]).toFixed(1)).join(' L');
  document.getElementById('elevLine').setAttribute('d',dLine);
  document.getElementById('elevArea').setAttribute('d',dLine+` L${W} ${H} L0 ${H} Z`);
  // gridlines
  let g='';for(let i=1;i<5;i++){const yy=PADT+i/5*(H-PADT-PADB);g+=`<line x1="0" y1="${yy}" x2="${W}" y2="${yy}" stroke="rgba(246,242,234,.08)" stroke-width="1"/>`}
  document.getElementById('gridLines').innerHTML=g;
  // interpolate elevation at a given mile
  function elevAt(mi){
    for(let i=0;i<pts.length-1;i++){
      if(mi>=pts[i][0]&&mi<=pts[i+1][0]){
        const t=(mi-pts[i][0])/(pts[i+1][0]-pts[i][0]);
        return pts[i][1]+t*(pts[i+1][1]-pts[i][1]);
      }
    }
    return pts[pts.length-1][1];
  }
  const svg=document.getElementById('elevSvg'),cur=document.getElementById('elCursor'),dot=document.getElementById('elDot'),
        elMile=document.getElementById('elMile'),elElev=document.getElementById('elElev');
  function moveCursor(clientX){
    const r=svg.getBoundingClientRect();
    let px=(clientX-r.left)/r.width;px=Math.max(0,Math.min(1,px));
    const mi=px*MAXM, e=elevAt(mi), vx=x(mi), vy=y(e);
    cur.setAttribute('x1',vx);cur.setAttribute('x2',vx);cur.style.opacity=1;
    dot.setAttribute('cx',vx);dot.setAttribute('cy',vy);dot.style.opacity=1;
    elMile.textContent=mi.toFixed(1);
    elElev.textContent=Math.round(e).toLocaleString();
  }
  svg.addEventListener('mousemove',e=>moveCursor(e.clientX));
  svg.addEventListener('touchmove',e=>{moveCursor(e.touches[0].clientX);},{passive:true});
  svg.addEventListener('mouseleave',()=>{cur.style.opacity=0;dot.style.opacity=0;elMile.textContent='0.0';elElev.textContent=pts[0][1].toLocaleString();});
  }

  // ---- FAQ accordion ----
  document.querySelectorAll('.faq-q').forEach(q=>{
    q.addEventListener('click',()=>{
      const item=q.parentElement,a=item.querySelector('.faq-a'),open=item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i=>{i.classList.remove('open');i.querySelector('.faq-a').style.maxHeight=null});
      if(!open){item.classList.add('open');a.style.maxHeight=a.scrollHeight+'px';}
    });
  });

  // ---- button micro-confirmation ----
  function notify(btn,msg){const o=btn.textContent;btn.textContent='✓ '+msg;btn.style.opacity='.85';setTimeout(()=>{btn.textContent=o;btn.style.opacity='1';},2200);}
  function subscribe(){
    const i=document.getElementById('emailInput'),m=document.getElementById('signupMsg');
    if(/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(i.value)){m.textContent="You're on the list — see you at the start line. (Demo only)";i.value='';}
    else{m.textContent='Please enter a valid email address.';}
  }

  // ---- scroll reveal ----
  const io=new IntersectionObserver((entries)=>{
    entries.forEach((en)=>{
      if(en.isIntersecting){
        const el=en.target;
        if(el.classList.contains('stagger')){
          [...el.children].forEach((c,i)=>{c.style.transitionDelay=(i*90)+'ms';});
        }
        el.classList.add('in');io.unobserve(el);
      }
    });
  },{threshold:.16});
  document.querySelectorAll('.reveal,.stagger').forEach(el=>io.observe(el));
</script>

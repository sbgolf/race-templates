---
const { race } = Astro.props;
const sponsors = (race.sponsors || []).filter(Boolean);
---

{sponsors.length > 0 ? (
<div class="sponsors">
  <div class="wrap">
    <p class="sp-lab">Proudly Supported By</p>
    <div class="sp-row">
      {sponsors.map((sponsor) => <span>{sponsor}</span>)}
    </div>
  </div>
</div>
) : null}

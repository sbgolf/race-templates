---
const { race } = Astro.props;
const volunteer = race.volunteer;
const volunteerUrl = volunteer?.signup_url;
const volunteerItems = volunteer?.items || volunteer?.benefits || [];
const visibleGallerySources = new Set([
  ...(race.private_mockup?.assets || []),
  ...(race.gallery || race.gallery_images || [])
].filter((asset) => asset?.src).slice(0, 9).map((asset) => asset.src));
const volunteerPhoto = volunteer?.photo?.src && !visibleGallerySources.has(volunteer.photo.src) ? volunteer.photo : null;
const shouldRender = Boolean(volunteer?.description || volunteerUrl || volunteerItems.length || volunteerPhoto?.src);
---

{shouldRender ? (
<section class="vol" id="volunteer">
  <div class="wrap">
    <div class="vol-grid">
      <div class="reveal">
        <div class="kicker">Volunteers</div>
        <h2 set:html={volunteer?.headline || 'Volunteer information'}></h2>
        {volunteer?.description ? <p>{volunteer.description}</p> : null}
        {volunteerItems.length ? <ul class="vol-list">{volunteerItems.map((item) => <li>{item}</li>)}</ul> : null}
        {volunteerUrl ? <a class="btn btn-accent" href={volunteerUrl} target="_blank" rel="noopener">{volunteer?.cta_label || 'Volunteer with us →'}</a> : null}
      </div>
      {volunteerPhoto?.src ? (
      <div class="reveal">
        <div class="vol-photo">
          <div class="ph-img mockup-photo-fill"><img src={volunteerPhoto.src} alt={volunteerPhoto.alt || `Volunteer image for ${race.identity?.name}`} loading="lazy" decoding="async" /></div>
        </div>
      </div>
      ) : null}
    </div>
  </div>
</section>
) : null}

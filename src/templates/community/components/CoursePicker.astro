---
const { race } = Astro.props;
const distances = race.distances || [];
const featuredDistance = distances.find((distance) => distance.featured) || distances[0];
const courseLocation = race.event?.venue || race.event?.location || 'Start / finish';
const isMultiDistance = distances.length > 1;
const lead = isMultiDistance
  ? 'Select an event distance to review the available course details.'
  : 'Review the available course details.';
const getElevationProfile = (distance) => {
  if (Array.isArray(distance?.elevation_profile) && distance.elevation_profile.length >= 2) return distance.elevation_profile;
  if (distance?.featured && Array.isArray(race.course?.elevation_profile) && race.course.elevation_profile.length >= 2) return race.course.elevation_profile;
  return [];
};
const formatFeet = (feet) => `${Math.round(Number(feet))} ft`;
const formatMile = (mile) => Number(mile).toFixed(Number.isInteger(Number(mile)) ? 0 : 2).replace(/\.00$/, '');
const buildProfile = (distance) => {
  const profile = getElevationProfile(distance);
  const feetValues = profile.map((point) => Number(point.feet)).filter(Number.isFinite);
  const mileValues = profile.map((point) => Number(point.mile)).filter(Number.isFinite);
  if (profile.length < 2 || feetValues.length < 2 || mileValues.length < 2) return null;
  const minFeet = Math.min(...feetValues);
  const maxFeet = Math.max(...feetValues);
  const maxMile = Math.max(...mileValues, Number(distance?.distance_miles || 0));
  const spread = Math.max(1, maxFeet - minFeet);
  const points = profile.map((point) => {
    const x = (Number(point.mile) / maxMile) * 500;
    const y = 170 - ((Number(point.feet) - minFeet) / spread) * 120;
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  }).join(' ');
  return {
    points,
    fillPoints: `0,200 ${points} 500,200`,
    minFeet,
    maxFeet,
    midFeet: minFeet + (spread / 2),
    maxMile,
    label: distance?.elevation_profile_label || `${distance?.name || 'Course'} elevation profile`
  };
};
const featuredProfile = buildProfile(featuredDistance);
const hasFeaturedElevationProfile = Boolean(featuredProfile);
const suppressCourseVisual = race.course?.suppress_visual === true;
const courseVisualImage = suppressCourseVisual ? null : (race.course?.image || race.course?.map_image || (!hasFeaturedElevationProfile ? race.story?.image : null));
const hasCourseVisualImage = Boolean(courseVisualImage?.src);
const detailRows = [
  ['Distance', featuredDistance?.distance, 'dDistance'],
  ['Total Ascent', featuredDistance?.elevation_gain, 'dGain'],
  ['Start Time', featuredDistance?.start_time, 'dStart'],
  ['Aid Stations', featuredDistance?.aid_stations === undefined ? undefined : String(featuredDistance.aid_stations), 'dAid'],
  ['Course Profile', featuredDistance?.profile, 'dProfile'],
  ['Certification', featuredDistance?.certification, 'dCert']
].filter(([, value]) => value);
const distanceData = Object.fromEntries(distances.map((distance) => {
  const profile = buildProfile(distance);
  return [distance.id, {
    name: distance.name,
    distance: distance.distance,
    gain: distance.elevation_gain || '',
    start: distance.start_time || '',
    aid: distance.aid_stations === undefined ? '' : String(distance.aid_stations),
    profile: distance.profile || '',
    certification: distance.certification || '',
    mapLabel: distance.map_label || distance.profile || '',
    elevation: profile ? {
      label: profile.label,
      points: profile.points,
      fillPoints: profile.fillPoints,
      minFeet: formatFeet(profile.minFeet),
      midFeet: formatFeet(profile.midFeet),
      maxFeet: formatFeet(profile.maxFeet),
      gain: distance.elevation_gain || '',
      distance: distance.distance || '',
      midMile: `${formatMile(profile.maxMile / 2)} mi`,
      maxMile: `${formatMile(profile.maxMile)} mi`,
      aria: `Elevation profile for ${distance.distance || distance.name || 'the course'} from ${formatFeet(profile.minFeet)} to ${formatFeet(profile.maxFeet)}${distance.elevation_gain ? ` with ${distance.elevation_gain} total ascent` : ''}`
    } : null
  }];
}));
---

{distances.length > 0 ? <section class="course" id="course">
  <div class="wrap">
    <div class="course-head">
      <div class="reveal">
        <div class="kicker">The Course</div>
        <h2 class="sec-title">{isMultiDistance ? <>Choose your <em>distance</em>.</> : <>Confirmed <em>distance</em>.</>}</h2>
        <p class="lead">{lead}</p>
      </div>
    </div>

    {isMultiDistance ? <div class="picker reveal" role="tablist" aria-label="Distance picker">
      {distances.map((distance) => <button class:list={["pk", { active: distance.id === featuredDistance?.id }]} role="tab" aria-selected={distance.id === featuredDistance?.id ? 'true' : 'false'} data-distance={distance.id} onclick="pickDistance(this)">
        {distance.name} <small>· {distance.distance}</small>
      </button>)}
    </div> : null}

    <div class:list={["course-grid", { "course-grid--details-only": !hasFeaturedElevationProfile && !hasCourseVisualImage }]}>
      {featuredProfile ? <div class="course-map course-map--profile reveal" data-distance-elevation-profile data-community-elevation-profile>
        <div class="course-profile-chart profile-chart--with-axis">
          <div class="course-profile-y-axis" aria-hidden="true">
            <span data-elevation-axis="max">{formatFeet(featuredProfile.maxFeet)}</span>
            <span data-elevation-axis="mid">{formatFeet(featuredProfile.midFeet)}</span>
            <span data-elevation-axis="min">{formatFeet(featuredProfile.minFeet)}</span>
          </div>
          <svg viewBox="0 0 500 200" preserveAspectRatio="none" aria-label={`Elevation profile from ${formatFeet(featuredProfile.minFeet)} to ${formatFeet(featuredProfile.maxFeet)}`} role="img" data-profile-svg>
            <line x1="0" y1="100" x2="500" y2="100" stroke="rgba(54,74,51,.14)" stroke-dasharray="4 4"/>
            <polyline points={featuredProfile.points} fill="none" stroke="var(--rust)" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" data-profile-line/>
            <polygon points={featuredProfile.fillPoints} fill="rgba(159,74,38,.12)" data-profile-fill/>
          </svg>
        </div>
        <div class="course-profile-mile">
          <span>0 mi</span><span data-profile-mile="mid">{formatMile(featuredProfile.maxMile / 2)} mi</span><span data-profile-mile="max">{formatMile(featuredProfile.maxMile)} mi</span>
        </div>
        <div class="course-profile-summary" data-profile-summary>
          <span>Distance: <b>{featuredDistance?.distance}</b></span>
          {featuredDistance?.elevation_gain ? <span>Total ascent: <b>{featuredDistance.elevation_gain}</b></span> : null}
        </div>
        <div class="map-info map-info--profile">
          <span>{courseLocation}</span>
          <b id="mapDistance">{featuredProfile.label}</b>
        </div>
      </div> : hasCourseVisualImage ? <div class="course-map course-map--image reveal" data-community-course-map-image>
        <img src={courseVisualImage.src} alt={courseVisualImage.alt || `${race.identity?.name || 'Race'} course map`} loading="lazy" decoding="async" />
        <div class="map-info">
          <span>{courseLocation}</span>
          <b id="mapDistance">{courseVisualImage.label || featuredDistance?.map_label || race.course?.type || 'Course map'}</b>
        </div>
      </div> : null}

      <div class="course-details reveal">
        {detailRows.map(([label, value, id]) => <div class="detail-row">
          <span class="l">{label}</span>
          <span class="v" id={id} class:list={[{ cert: id === 'dCert' }]}>{value}</span>
        </div>)}
      </div>
    </div>
  </div>
</section> : null}

{isMultiDistance ? <script define:vars={{ distanceData }}>
  window.pickDistance = function pickDistance(btn){
    document.querySelectorAll('.pk').forEach(p=>{p.classList.remove('active');p.setAttribute('aria-selected','false');});
    btn.classList.add('active');
    btn.setAttribute('aria-selected','true');
    const selected=btn.dataset.distance;
    const data=distanceData[selected];
    if(!data) return;

    const setText = (id, value) => { const el = document.getElementById(id); if (el) el.textContent = value; };
    setText('dDistance', data.distance);
    setText('dGain', data.gain);
    setText('dStart', data.start);
    setText('dAid', data.aid);
    setText('dProfile', data.profile);
    setText('dCert', data.certification);

    if (data.elevation) {
      const profileCard = document.querySelector('[data-distance-elevation-profile]');
      const profileLine = document.querySelector('[data-profile-line]');
      const profileFill = document.querySelector('[data-profile-fill]');
      const profileSvg = document.querySelector('[data-profile-svg]');
      profileCard?.classList.remove('is-empty');
      if (profileLine) profileLine.setAttribute('points', data.elevation.points);
      if (profileFill) profileFill.setAttribute('points', data.elevation.fillPoints);
      if (profileSvg) profileSvg.setAttribute('aria-label', data.elevation.aria);
      document.querySelector('[data-elevation-axis="max"]')?.replaceChildren(document.createTextNode(data.elevation.maxFeet));
      document.querySelector('[data-elevation-axis="mid"]')?.replaceChildren(document.createTextNode(data.elevation.midFeet));
      document.querySelector('[data-elevation-axis="min"]')?.replaceChildren(document.createTextNode(data.elevation.minFeet));
      document.querySelector('[data-profile-mile="mid"]')?.replaceChildren(document.createTextNode(data.elevation.midMile));
      document.querySelector('[data-profile-mile="max"]')?.replaceChildren(document.createTextNode(data.elevation.maxMile));
      const summary = document.querySelector('[data-profile-summary]');
      if (summary) {
        summary.innerHTML = '';
        const distanceItem = document.createElement('span');
        distanceItem.innerHTML = `Distance: <b>${data.elevation.distance}</b>`;
        summary.append(distanceItem);
        if (data.elevation.gain) {
          const gainItem = document.createElement('span');
          gainItem.innerHTML = `Total ascent: <b>${data.elevation.gain}</b>`;
          summary.append(gainItem);
        }
      }
      setText('mapDistance', data.elevation.label);
    }

    if (!data.elevation && document.querySelector('[data-community-course-map-image]')) {
      setText('mapDistance', data.mapLabel || data.name || 'Course map');
    }

    document.dispatchEvent(new CustomEvent('community-distance-change',{detail:{selected,data}}));
  }
</script> : null}

---
const { race } = Astro.props;
const schedule = race.schedule || [];
const scheduleByDay = schedule.reduce((groups, item) => {
  const key = item.day || 'Race Day';
  groups[key] ||= [];
  groups[key].push(item);
  return groups;
}, {});
const featuredDistance = race.distances?.find((distance) => distance.featured) || race.distances?.[0];
const isSingleDistance = (race.distances || []).length === 1;
---

{schedule.length > 0 ? (
<section class="sched" id="schedule">
  <div class="wrap">
    <div class="sched-head reveal">
      <div class="kicker">Race Schedule</div>
      <h2 class="sec-title">{isSingleDistance ? <>Key <em>times</em>.</> : <>Race weekend <em>plan</em>.</>}</h2>
      <p class="lead">{isSingleDistance ? 'Race-day times and locations at a glance.' : 'Schedule below filters based on your selected distance.'}</p>
      {!isSingleDistance ? (
      <div class="sched-filter">
        <span class="dot"></span>
        Showing schedule for: <b id="filterLabel">{featuredDistance?.name}</b>
      </div>
      ) : null}
    </div>

    <div class="timeline">
      {Object.entries(scheduleByDay).map(([day, items]) => <div class="tl-day">
        <div class="date">{day}</div>
        <h3>{items[0]?.group_title || (day.includes('Friday') ? 'Packet Pickup' : 'Race Day')}</h3>
        {items.map((item) => {
          const appliesTo = item.applies_to_distances || ['all'];
          const visible = isSingleDistance || appliesTo.includes('all') || appliesTo.includes(featuredDistance?.id);
          return <div class="tl-event" data-distance={appliesTo.join(',')} data-hide={String(!visible)}>
            <div>
              <div class="tl-event-name">{item.name}</div>
              {item.location ? <small>{item.location}</small> : null}
            </div>
            <div class="tl-event-time">{item.time}</div>
          </div>;
        })}
      </div>)}
    </div>
  </div>
</section>
) : null}

<script is:inline>
  document.addEventListener('community-distance-change',(event)=>{
    const { selected, data } = event.detail;
    const label=document.getElementById('filterLabel');
    if(label) label.textContent=data.name;
    document.querySelectorAll('.tl-event').forEach((item)=>{
      const distances=item.dataset.distance || 'all';
      const visible=distances==='all'||distances.split(',').includes(selected);
      item.dataset.hide=String(!visible);
    });
  });
</script>

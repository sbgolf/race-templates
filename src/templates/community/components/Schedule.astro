---
const { race } = Astro.props;
const scheduleByDay = (race.schedule || []).reduce((groups, item) => {
  const key = item.day || 'Race Day';
  groups[key] ||= [];
  groups[key].push(item);
  return groups;
}, {});
const featuredDistance = race.distances?.find((distance) => distance.featured) || race.distances?.[0];
---

<section class="sched" id="schedule">
  <div class="wrap">
    <div class="sched-head reveal">
      <div class="kicker">Race Weekend</div>
      <h2 class="sec-title">A whole weekend, <em>not just a race</em>.</h2>
      <p class="lead">Pickup Friday, race Saturday morning, awards and pancakes after. Schedule below filters based on your selected distance.</p>
      <div class="sched-filter">
        <span class="dot"></span>
        Showing schedule for: <b id="filterLabel">{featuredDistance?.name}</b>
      </div>
    </div>

    <div class="timeline">
      {Object.entries(scheduleByDay).map(([day, items]) => <div class="tl-day">
        <div class="date">{day}</div>
        <h3>{day.includes('Friday') ? 'Packet Pickup' : 'Race Day'}</h3>
        {items.map((item) => <div class="tl-event" data-distance={(item.applies_to_distances || ['all']).join(',')}>
          <div>
            <div class="tl-event-name">{item.name}</div>
            <small>{item.location}</small>
          </div>
          <div class="tl-event-time">{item.time}</div>
        </div>)}
      </div>)}
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('community-distance-change',(event)=>{
    const { selected, data } = event.detail;
    const label=document.getElementById('filterLabel');
    if(label) label.textContent=data.name;
    document.querySelectorAll('.tl-event').forEach((item)=>{
      const distances=item.dataset.distance || 'all';
      const visible=distances==='all'||distances.split(',').includes(selected);
      item.dataset.hide=String(!visible);
    });
  });
</script>

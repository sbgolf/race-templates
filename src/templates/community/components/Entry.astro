---
import { registerClickAttributes } from "../../../shared/analytics/register-click.mjs";
const { race } = Astro.props;
const registerUrl = race.registration?.url || '#';
---

<section class="entry" id="entry">
  <div class="wrap">
    <div class="reveal">
      <div class="kicker">Register</div>
      <h2 class="sec-title">Pick a distance, <em>save your spot</em>.</h2>
      <p class="lead">{race.registration?.opens ? `Registration opens ${race.registration.opens}. ` : ''}Choose your distance and complete registration through the official race platform.</p>
    </div>

    <div class="entry-grid stagger">
      {race.distances?.map((distance) => {
        const attrs = registerClickAttributes(race, `entry-${distance.id}`);
        return <div class:list={["etier", { flagship: distance.featured }]}>
          <h3>{distance.name}</h3>
          <div class="sub">{distance.distance} · {distance.start_time || 'Start time TBA'}</div>
          {distance.price ? <div class="pp">{distance.price}<small>/ entry</small></div> : null}
          <ul>
            {(distance.highlights || ['Official timing', 'Race-day support', 'Community finish-line experience']).map((item) => <li>{item}</li>)}
          </ul>
          <a class:list={["btn", distance.featured ? "btn-accent" : "btn-dark"]} href={registerUrl} target="_blank" rel="noopener" {...attrs}>{race.registration?.cta_label || 'Register'}</a>
        </div>;
      })}
    </div>

    <div class="charity-note reveal">
      <span class="ic">🎓</span>
      <div class="ct">
        <h4>Run for the Hartwell Education Foundation</h4>
        <p>Add a $50, $100, or $250 donation at checkout. 100% goes to local schools. Top fundraisers get pre-race shoutouts and gear.</p>
      </div>
      <a class="btn btn-ghost" href={registerUrl} target="_blank" rel="noopener" {...registerClickAttributes(race, 'entry-charity')}>Learn more about race donations</a>
    </div>
  </div>
</section>

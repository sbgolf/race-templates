---
import { registerClickAttributes } from "../../../shared/analytics/register-click.mjs";
const { race } = Astro.props;
const registerUrl = race.registration?.url || '#';
const distanceMeta = (distance) => [distance?.distance, distance?.start_time].filter(Boolean).join(' · ');
---

<section class="entry" id="entry">
  <div class="wrap">
    <div class="reveal">
      <div class="kicker">Register</div>
      <h2 class="sec-title">{(race.distances || []).length === 1 ? <>Review the <em>{race.distances?.[0]?.name || 'race'}</em>.</> : <>Pick a distance, <em>save your spot</em>.</>}</h2>
      <p class="lead">{race.registration?.opens ? `Registration opens ${race.registration.opens}. ` : ''}{(race.distances || []).length === 1 ? 'Use the official race link for registration details and current availability.' : 'Choose your distance and complete registration through the official race platform.'}</p>
    </div>

    <div class="entry-grid stagger">
      {race.distances?.map((distance) => {
        const attrs = registerClickAttributes(race, `entry-distance-${distance.id}`);
        return <div class:list={["etier", { flagship: distance.featured }]}>
          <h3>{distance.name}</h3>
          {distanceMeta(distance) ? <div class="sub">{distanceMeta(distance)}</div> : null}
          {distance.price ? <div class="pp">{distance.price}<small>/ entry</small></div> : null}
          {distance.highlights?.length ? <ul>
            {distance.highlights.map((item) => <li>{item}</li>)}
          </ul> : null}
          <a class:list={["btn", distance.featured ? "btn-accent" : "btn-dark"]} href={registerUrl} target="_blank" rel="noopener" {...attrs}>{race.registration?.cta_label || 'Register'}</a>
        </div>;
      })}
    </div>

    {race.charity?.headline || race.charity?.description ? (
    <div class="charity-note reveal">
      <span class="ic">{race.charity?.icon || '★'}</span>
      <div class="ct">
        {race.charity?.headline ? <h4>{race.charity.headline}</h4> : null}
        {race.charity?.description ? <p>{race.charity.description}</p> : null}
      </div>
      {race.charity?.url ? <a class="btn btn-ghost" href={race.charity.url} target="_blank" rel="noopener">{race.charity?.cta_label || 'Learn more'}</a> : null}
    </div>
    ) : null}
  </div>
</section>

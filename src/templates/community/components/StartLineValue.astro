---
import { registerClickAttributes } from "../../../shared/analytics/register-click.mjs";
import { privateValueNarrativeForRace } from "../../../shared/private-mockup-value.mjs";
import { registrationPlatformLabel } from "../../../shared/registration-platform-label.mjs";
const { race } = Astro.props;
const isPrivateMockup = Boolean(race.private_mockup?.generated || race.private_mockup);

const value = privateValueNarrativeForRace(race);
const { headline, intro, improved } = value;
const paidIncludes = value.paid_includes;
const platformLabel = race.registration?.platform
  ? registrationPlatformLabel(race.registration.platform)
  : null;
const registrationFacts = [
  platformLabel ? `Registration platform: ${platformLabel}` : null,
  race.registration?.url ? 'Official registration link is configured for every primary CTA.' : null
].filter(Boolean);
const distanceFacts = (race.distances || [])
  .filter((distance) => distance?.name || distance?.distance || distance?.start_time)
  .map((distance) => [distance.name, distance.distance, distance.start_time].filter(Boolean).join(' · '));
const scheduleFacts = (race.schedule || [])
  .filter((item) => item?.name || item?.time || item?.location)
  .slice(0, 3)
  .map((item) => [item.time, item.name, item.location].filter(Boolean).join(' · '));
const faqCount = (race.faqs || race.faq || []).filter((item) => item?.question && item?.answer).length;
const sourceUrl = race.private_mockup?.source_url || race.private_mockup?.provenance?.source_url;
const sourceLinkAttrs = sourceUrl && sourceUrl === race.registration?.url ? registerClickAttributes(race, 'private-source-registration') : {};
const uncertaintySummary = race.private_mockup?.uncertainty?.summary;
const sourceSections = race.private_mockup?.provenance?.source_confirmed_sections || [];
const factGroups = [
  registrationFacts.length ? { title: 'Registration path', items: registrationFacts } : null,
  distanceFacts.length ? { title: 'Source-backed distances', items: distanceFacts } : null,
  scheduleFacts.length ? { title: 'Schedule signals', items: scheduleFacts } : null,
  faqCount ? { title: 'Runner questions', items: [`${faqCount} source-backed FAQ${faqCount === 1 ? '' : 's'} rendered.`] } : null
].filter(Boolean);
---

{isPrivateMockup ? (
<section class="startline-value" id="startline-value" data-private-value-narrative>
  <div class="wrap startline-value-wrap">
    <div class="startline-value-hero reveal">
      <div class="kicker">StartLine value wrapper</div>
      <h2>{headline}</h2>
      <p>{intro}</p>
    </div>

    <div class="startline-value-grid stagger">
      <article class="startline-value-card startline-value-card-primary">
        <span class="startline-value-label">What StartLine improved</span>
        <ul>
          {improved.map((item) => <li>{item}</li>)}
        </ul>
      </article>

      <article class="startline-value-card">
        <span class="startline-value-label">What a paid StartLine build includes</span>
        <ul>
          {paidIncludes.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </div>

    {factGroups.length ? (
      <div class="startline-value-facts reveal">
        <span class="startline-value-label">Configured race facts used in this concept</span>
        <div class="startline-fact-grid">
          {factGroups.map((group) => (
            <article class="startline-fact-card">
              <h3>{group.title}</h3>
              <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
            </article>
          ))}
        </div>
      </div>
    ) : null}

    <aside class="startline-source-note reveal">
      <strong>Private concept note</strong>
      <p>
        This private mockup is framed around registration click-through readiness and uses only configured or source-backed race details. It avoids overpromising registration outcomes and should be reviewed before prospect sharing.
      </p>
      {sourceUrl ? <p>Primary source: <a href={sourceUrl} target="_blank" rel="noopener" {...sourceLinkAttrs}>View original source page</a></p> : null}
      {sourceSections.length ? <p>Source-confirmed sections: {sourceSections.join(', ')}</p> : null}
      {uncertaintySummary ? <p>Uncertainty: {uncertaintySummary}</p> : null}
    </aside>
  </div>
</section>
) : null}

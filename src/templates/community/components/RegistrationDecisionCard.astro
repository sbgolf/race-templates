---
import { registerClickAttributes } from "../../../shared/analytics/register-click.mjs";
import { registrationDecisionCopyForRace } from "../../../shared/private-mockup-value.mjs";
const { race } = Astro.props;
const registerUrl = race.registration?.url || '#';
const decisionCopy = registrationDecisionCopyForRace(race);
const registerLabel = decisionCopy.ctaLabel;
const registerAttrs = registerClickAttributes(race, 'registration-decision-card');
const shouldRender = race.private_mockup?.show_registration_decision === true;
---

{shouldRender ? (
  <section class="registration-decision reveal" data-registration-decision-card>
    <div class="wrap decision-wrap">
      <div class="decision-card">
        <div>
          <div class="kicker">{decisionCopy.kicker}</div>
          <h2 class="sec-title">{decisionCopy.headline}</h2>
          <p class="lead">
            {decisionCopy.body}
          </p>
        </div>
        <a class="btn btn-accent decision-cta" href={registerUrl} target="_blank" rel="noopener" {...registerAttrs}>{registerLabel}</a>
      </div>
    </div>
  </section>
) : null}

<style>
  .registration-decision {
    background: #fffaf1;
    overflow-x: clip;
  }

  .decision-wrap {
    padding-block: clamp(2.25rem, 5vw, 4rem);
  }

  .decision-card {
    align-items: center;
    background: linear-gradient(135deg, rgba(36, 27, 21, 0.96), rgba(78, 50, 32, 0.94));
    border-radius: clamp(1.1rem, 3vw, 1.7rem);
    box-shadow: 0 24px 60px rgba(39, 29, 19, 0.18);
    color: #fff8ee;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: minmax(0, 1fr) auto;
    min-width: 0;
    padding: clamp(1.35rem, 4vw, 2.2rem);
  }

  .decision-card .kicker,
  .decision-card .lead {
    color: rgba(255, 248, 238, 0.78);
  }

  .decision-card .sec-title {
    color: #fff8ee;
    margin-bottom: 0.55rem;
  }

  .decision-card .lead {
    margin: 0;
    max-width: 72ch;
  }

  .decision-cta {
    justify-self: end;
    text-align: center;
    white-space: normal;
  }

  @media (max-width: 760px) {
    .decision-card {
      grid-template-columns: 1fr;
    }

    .decision-cta {
      justify-self: stretch;
    }
  }

  @media (max-width: 420px) {
    .decision-wrap {
      padding-inline: 0.85rem;
    }
  }
</style>

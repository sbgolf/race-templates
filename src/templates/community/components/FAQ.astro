---
const { race } = Astro.props;
const faqs = (race.faqs || race.faq || []).filter((item) => item?.question && item?.answer);
---

{faqs.length > 0 ? (
<section class="faq" id="faq">
  <div class="wrap faq-wrap">
    <div class="reveal">
      <div class="kicker">Good to know</div>
      <h2 class="sec-title">Common <em>questions</em>.</h2>
    </div>
    <div class="faq-list">
      {faqs.map((item) => (
        <div class="faq-item"><button class="faq-q">{item.question}<span class="pm"></span></button><div class="faq-a"><p>{item.answer}</p></div></div>
      ))}
    </div>
  </div>
</section>
) : null}

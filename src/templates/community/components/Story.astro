---
const { race } = Astro.props;
const story = race.story;
const isPrivateMockup = Boolean(race.private_mockup?.generated);
const shouldRender = story || (isPrivateMockup && race.seo?.meta_description);
const title = story?.title || (isPrivateMockup ? `About ${race.identity?.name}` : 'Our Race');
const paragraphs = story?.paragraphs || [
  race.seo?.meta_description,
].filter(Boolean);
const links = (story?.links || story?.course_links || []).filter((link) => link?.url && link?.label);
---

{shouldRender ? (
<section class="story" id="story">
  <div class="wrap">
    <div class="story-grid">
      <div class="reveal">
        <div class="kicker">{story?.kicker || (isPrivateMockup ? 'Race overview' : 'Our Race')}</div>
        <h2 set:html={title}></h2>
        {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        {links.length ? (
          <div class="story-links" aria-label="Race resources">
            {links.map((link) => <a href={link.url} target="_blank" rel="noopener">{link.label}</a>)}
          </div>
        ) : null}
        {story?.quote ? <div class="story-quote">{story.quote}</div> : null}
        {story?.quote_byline ? <div class="story-quote-byline">{story.quote_byline}</div> : null}
      </div>
      {story?.image?.src ? (
      <div class="reveal">
        <div class="story-photo">
          <div class="ph-img mockup-photo-fill"><img src={story.image.src} alt={story.image.alt || `Race story image for ${race.identity?.name}`} loading="lazy" decoding="async" /></div>
        </div>
      </div>
      ) : null}
    </div>
  </div>
</section>
) : null}

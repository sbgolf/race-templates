---
import { registerClickAttributes } from "../../../shared/analytics/register-click.mjs";
const { race } = Astro.props;
const registerAttrs = registerClickAttributes(race, 'hero-primary');
const registerUrl = race.registration?.url || '#entry';
const registerLabel = race.registration?.cta_label || 'Register now';
const eventDate = race.event?.date ? new Date(`${race.event.date}T12:00:00`) : null;
const displayDate = eventDate ? eventDate.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }) : 'Race day';
const isPrivateMockup = Boolean(race.private_mockup);
const editionLabel = race.identity?.edition || (isPrivateMockup ? null : 'Community race');
const heroEyebrow = [editionLabel, race.event?.location].filter(Boolean).join(' · ');
const featuredDistance = race.distances?.find((distance) => distance.featured) || race.distances?.[0];
const heroImage = race.identity?.hero_image?.src || race.private_mockup?.assets?.[0]?.src;
const heroImageAlt = race.identity?.hero_image?.alt || `Race day image for ${race.identity?.name}`;
const heroImageFit = race.identity?.hero_image?.fit === 'contain' ? 'contain' : 'cover';
const heroTitle = race.identity?.name || race.identity?.tagline || 'Community race weekend';
const heroSubtitle = race.identity?.tagline && race.identity.tagline !== heroTitle ? race.identity.tagline : null;
const heroPhotoMeta = race.identity?.hero_meta || (isPrivateMockup ? (race.event?.date_label || race.event?.date) : [race.event?.date, featuredDistance?.start_time].filter(Boolean).join(' · '));
const hasRunnerChecklist = Boolean(isPrivateMockup && (race.runner_decision_checklist?.items || []).length);
const secondaryCtaLabel = hasRunnerChecklist ? 'Review key race details' : 'See the Course';
const secondaryCtaTarget = hasRunnerChecklist ? 'runner-checklist' : 'course';
---

<section class="hero" id="top">
  <div class="hero-inner">
    <div class="hero-copy reveal">
      <div class="hero-eyebrow">{heroEyebrow}</div>
      <h1>{heroTitle}</h1>
      {heroSubtitle ? <p class="hero-tagline">{heroSubtitle}</p> : null}
      <div class="hero-date">{displayDate}</div>
      <p class="lead">{race.seo?.meta_description}</p>
      {(race.distances || []).length > 1 ? (
      <div class="hero-distances">
        {race.distances?.map((distance) => <span class="dist-chip">{distance.name}</span>)}
      </div>
      ) : null}
      <div class="hero-cta">
        <a class="btn btn-accent" href={registerUrl} target="_blank" rel="noopener" {...registerAttrs}>{registerLabel}</a>
        <button class="btn btn-ghost" onclick={`scrollToId('${secondaryCtaTarget}')`}>{secondaryCtaLabel}</button>
      </div>
    </div>
    <div class="reveal">
      <div class="hero-photo">
        <div class="hero-meta-strip">
          <span class="hero-meta-pill">RACE DAY</span>
          <span class="hero-meta-pill right">{heroPhotoMeta}</span>
        </div>
        {heroImage ? (
        <div class={`ph-img ph-town mockup-photo-fill mockup-photo-fill--${heroImageFit}`}>
          <img src={heroImage} alt={heroImageAlt} loading="eager" decoding="async" />
        </div>
        ) : (
        <div class="ph-img ph-town">
          <svg viewBox="0 0 400 500" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <!-- soft dawn glow -->
            <ellipse cx="200" cy="120" rx="220" ry="80" fill="#FFE7B8" opacity=".35"/>
            <circle cx="280" cy="100" r="40" fill="#FFEFC8" opacity=".7"/>
            <!-- distant tree line -->
            <path d="M0 280 L40 250 L80 270 L120 245 L160 265 L200 240 L240 260 L280 235 L320 255 L360 240 L400 260 L400 500 L0 500Z" fill="#7A4B33" opacity=".4"/>
            <!-- main-street town silhouette -->
            <g fill="#5C3A2F" opacity=".88">
              <rect x="30" y="320" width="60" height="120"/>
              <rect x="90" y="290" width="48" height="150"/>
              <polygon points="90,290 114,265 138,290"/>
              <rect x="138" y="310" width="55" height="130"/>
              <rect x="193" y="280" width="42" height="160"/>
              <polygon points="193,280 214,255 235,280"/>
              <rect x="235" y="310" width="50" height="130"/>
              <rect x="285" y="295" width="55" height="145"/>
              <polygon points="285,295 312,272 340,295"/>
              <rect x="340" y="318" width="60" height="122"/>
            </g>
            <!-- windows dim glow -->
            <g fill="#FFD79B" opacity=".55">
              <rect x="40" y="340" width="6" height="8"/>
              <rect x="55" y="340" width="6" height="8"/>
              <rect x="70" y="340" width="6" height="8"/>
              <rect x="100" y="320" width="6" height="8"/>
              <rect x="120" y="320" width="6" height="8"/>
              <rect x="200" y="310" width="6" height="8"/>
              <rect x="215" y="310" width="6" height="8"/>
              <rect x="295" y="330" width="6" height="8"/>
              <rect x="320" y="330" width="6" height="8"/>
              <rect x="355" y="350" width="6" height="8"/>
            </g>
            <!-- street line -->
            <rect x="0" y="440" width="400" height="60" fill="#3A2515" opacity=".85"/>
            <rect x="0" y="465" width="400" height="2" fill="#D89B2A" opacity=".4"/>
          </svg>
        </div>
        )}
      </div>
    </div>
  </div>
</section>

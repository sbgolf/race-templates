---
const { race } = Astro.props;
---

<footer>
  <div class="foot">
    <div>
      <div class="brand" style="color:var(--paper)">
        <svg class="mark" viewBox="0 0 40 40" fill="none" style="width:30px;height:30px">
          <circle cx="20" cy="20" r="18" fill="#C6643D"/>
          <path d="M12 20 L17 25 L28 14" stroke="#FAF6EE" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        </svg>
        <span>HARTWELL<small>Hometown Half</small></span>
      </div>
      <p>The race that brings a town together. 14 years and counting — every dollar to local schools.</p>
    </div>
    <div><div class="foot-heading">Race</div><ul><li><a href="#course">Course</a></li><li><a href="#schedule">Weekend</a></li><li><a href="#entry">Register</a></li><li><a href="#volunteer">Volunteer</a></li></ul></div>
    <div><div class="foot-heading">About</div><ul><li><a href="#story">Our Race</a></li><li><a href="#gallery">Gallery</a></li><li><a href="#faq">FAQ</a></li><li><a href="#">Contact</a></li></ul></div>
    <div><div class="foot-heading">Connect</div><ul><li><a href="#">Newsletter</a></li><li><a href="#">Instagram</a></li><li><a href="#">Facebook</a></li><li><a href="#">Race Photos</a></li></ul></div>
  </div>
  <div class="foot-bottom">
    <span>© 2026 Hartwell Hometown Half · A program of Hartwell Education Foundation</span>
    <span>Powered by [BRAND]</span>
  </div>
</footer>

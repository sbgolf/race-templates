---
import { registerClickAttributes } from "../../../shared/analytics/register-click.mjs";
import SocialLinksRow from "../../../shared/components/SocialLinksRow.astro";
const { race } = Astro.props;
const year = race.event?.date ? new Date(`${race.event.date}T12:00:00`).getFullYear() : new Date().getFullYear();
const registerUrl = race.registration?.url || '#entry';
const registerLabel = race.registration?.cta_label || 'Register';
const registerAttrs = registerClickAttributes(race, 'footer-official');
const hasCourse = (race.distances || []).length > 0;
const hasSchedule = (race.schedule || []).length > 0;
const hasStory = Boolean(race.story || race.private_mockup?.generated);
const hasGallery = Boolean((race.private_mockup?.assets || []).length || (race.gallery || race.gallery_images || []).length);
const hasVolunteer = Boolean(race.volunteer?.description || race.volunteer?.signup_url || (race.volunteer?.items || race.volunteer?.benefits || []).length || race.volunteer?.photo?.src);
const hasSponsors = (race.sponsors || []).length > 0;
const hasFaq = (race.faq || race.faqs || []).length > 0;
const isPrivateMockup = Boolean(race.private_mockup);
const raceLinks = [
  hasCourse ? { href: '#course', label: 'Course' } : null,
  hasSchedule ? { href: '#schedule', label: 'Schedule' } : null,
  { href: '#entry', label: 'Register' },
  hasVolunteer ? { href: '#volunteer', label: 'Volunteer' } : null
].filter(Boolean);
const aboutLinks = [
  hasStory ? { href: '#story', label: race.private_mockup?.generated ? 'Race overview' : 'Our Race' } : null,
  hasGallery ? { href: '#gallery', label: 'Gallery' } : null,
  hasSponsors ? { href: '#sponsors', label: 'Sponsors' } : null,
  hasFaq ? { href: '#faq', label: 'FAQ' } : null
].filter(Boolean);
---

<footer>
  <div class="foot">
    <div>
      <div class="brand" style="color:var(--paper)">
        <svg class="mark" viewBox="0 0 40 40" fill="none" style="width:30px;height:30px">
          <circle cx="20" cy="20" r="18" fill="#C6643D"/>
          <path d="M12 20 L17 25 L28 14" stroke="#FAF6EE" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        </svg>
        <span>{race.identity?.name}<small>{race.identity?.tagline}</small></span>
      </div>
      <p>{race.seo?.meta_description || race.identity?.tagline}</p>
      <SocialLinksRow race={race} variant="community" />
    </div>
    <div><div class="foot-heading">Race</div><ul>{raceLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul></div>
    {aboutLinks.length ? <div><div class="foot-heading">About</div><ul>{aboutLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul></div> : null}
    <div><div class="foot-heading">Official site</div><ul><li><a href={registerUrl} target="_blank" rel="noopener" {...registerAttrs}>{registerLabel}</a></li></ul></div>
  </div>
  <div class="foot-bottom">
    <span>© {year} {race.identity?.name}{race.organization?.name ? ` · A program of ${race.organization.name}` : ''}</span>
    {!isPrivateMockup ? <span>Powered by StartLine Sites</span> : null}
  </div>
</footer>

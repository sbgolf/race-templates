---
const { race } = Astro.props;
const capturedAssets = race.private_mockup?.assets || [];
const galleryImages = race.gallery || race.gallery_images || [];
const images = [...capturedAssets, ...galleryImages].filter((asset) => asset?.src);
---

{images.length > 0 ? (
<section class="gallery" id="gallery">
  <div class="wrap">
    <div class="gallery-head reveal">
      <div class="kicker">Race Day, captured</div>
      <h2 class="sec-title">What it actually <em>looks like</em>.</h2>
      <p class="lead">Images shown here come from configured race assets or public source images captured for this private concept.</p>
    </div>

    <div class="gallery-grid reveal">
      {images.map((asset, index) => (
      <figure class={`g-photo g${(index % 9) + 1}`}>
        <div class="ph-img mockup-photo-fill">
          <img src={asset.src} alt={asset.alt || `Race image for ${race.identity?.name}`} loading="lazy" decoding="async" />
        </div>
        {asset.caption ? <figcaption>{asset.caption}</figcaption> : null}
      </figure>
      ))}
    </div>
  </div>
</section>
) : null}

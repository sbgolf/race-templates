---
import { registerClickAttributes } from "../../../shared/analytics/register-click.mjs";
const { race } = Astro.props;
const registerAttrs = registerClickAttributes(race, 'nav');
const registerUrl = race.registration?.url || '#entry';
const registerLabel = race.registration?.cta_label || 'Register';
const hasSchedule = (race.schedule || []).length > 0;
const hasStory = Boolean(race.story || race.private_mockup?.generated);
const hasGallery = Boolean((race.private_mockup?.assets || []).length || (race.gallery || race.gallery_images || []).length);
const hasVolunteer = Boolean(race.volunteer?.description || race.volunteer?.signup_url || (race.volunteer?.items || race.volunteer?.benefits || []).length || race.volunteer?.photo?.src);
---

<nav id="nav">
  <a href="#top" class="brand">
    <svg class="mark" viewBox="0 0 40 40" fill="none">
      <circle cx="20" cy="20" r="18" fill="#C6643D"/>
      <path d="M12 20 L17 25 L28 14" stroke="#FAF6EE" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
    </svg>
    <span>{race.identity?.name || 'Community Race'}<small>{race.identity?.tagline || 'Race weekend'}</small></span>
  </a>
  <div class="nav-links" id="navLinks">
    <a href="#course">Course</a>
    {hasSchedule ? <a href="#schedule">Schedule</a> : null}
    {hasStory ? <a href="#story">Details</a> : null}
    {hasGallery ? <a href="#gallery">Gallery</a> : null}
    {hasVolunteer ? <a href="#volunteer">Volunteer</a> : null}
    <a href={registerUrl} target="_blank" rel="noopener" {...registerAttrs}>Register</a>
    <a class="btn btn-accent" href={registerUrl} target="_blank" rel="noopener" {...registerAttrs}>{registerLabel} →</a>
  </div>
  <button class="hamburger" id="burger" aria-label="Menu"><span></span><span></span><span></span></button>
</nav>

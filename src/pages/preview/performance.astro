---
import PerformancePreview from "../../templates/performance/pages/PerformancePreview.astro";
import capital from "../../data/samples/capital-marathon.json";
import { ga4Snippet, registerClickListenerScript } from "../../shared/analytics/register-click.mjs";
import { sportsEventJsonLdScript } from "../../shared/schema/sports-event-jsonld.mjs";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{capital.seo.meta_title}</title>
  <meta name="description" content={capital.seo.meta_description}>
  <Fragment set:html={ga4Snippet(capital)} />
  <Fragment set:html={sportsEventJsonLdScript(capital)} />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Crect width='40' height='40' rx='6' fill='%232D5BFF'/%3E%3Cpath d='M11 24 L15 17 L21 24 L26 14 L31 24' stroke='%23FAFAFC' stroke-width='2.6' stroke-linecap='round' stroke-linejoin='round' fill='none'/%3E%3C/svg%3E">
</head>
<body>
  <PerformancePreview race={capital} />
  <Fragment set:html={registerClickListenerScript()} />
</body>
</html>

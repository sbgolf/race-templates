---
import config from '../../data/samples/capital-marathon.json';
import { registerClickAttributes, registerClickListenerScript, ga4Snippet } from '../../shared/analytics/register-click.mjs';
const registerAttrs = registerClickAttributes(config, 'preview-hero');
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{config.seo.meta_title}</title>
    <meta name="description" content={config.seo.meta_description} />
    <Fragment set:html={ga4Snippet(config)} />
    <style>
      :root { color-scheme: dark; font-family: Inter, system-ui, sans-serif; }
      body { margin: 0; background: #0a0d14; color: #f8fafc; }
      main { min-height: 100vh; display: grid; place-items: center; padding: 2rem; }
      section { max-width: 760px; border-left: 8px solid #d71920; padding-left: 2rem; }
      .eyebrow { color: #f87171; font-weight: 900; text-transform: uppercase; letter-spacing: .12em; }
      h1 { font-size: clamp(3rem, 9vw, 7rem); line-height: .9; margin: .25rem 0; text-transform: uppercase; }
      a { display: inline-flex; margin-top: 1rem; padding: 1rem 1.25rem; background: #d71920; color: white; border-radius: .4rem; font-weight: 900; text-decoration: none; text-transform: uppercase; }
      .proof { color: #cbd5e1; }
    </style>
  </head>
  <body>
    <main>
      <section>
        <p class="eyebrow">{config.event.date} · {config.event.location}</p>
        <h1>{config.identity.name}</h1>
        <p>{config.identity.tagline}</p>
        <p class="proof">BQ rate: {config.proof.bq_rate} · BQ finishers: {config.proof.bq_finishers}</p>
        <a href={config.registration.url} {...registerAttrs}>{config.registration.cta_label}</a>
      </section>
    </main>
    <Fragment set:html={registerClickListenerScript()} />
  </body>
</html>

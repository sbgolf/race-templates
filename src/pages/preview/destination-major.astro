---
import DestinationMajorPreview from "../../templates/destination-major/pages/DestinationMajorPreview.astro";
import cascade from "../../data/samples/cascade-marathon.json";
import { ga4Snippet, registerClickListenerScript } from "../../shared/analytics/register-click.mjs";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{cascade.seo.meta_title}</title>
  <meta name="description" content={cascade.seo.meta_description}>
  <Fragment set:html={ga4Snippet(cascade)} />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Crect width='40' height='40' fill='%230B0E13'/%3E%3Cpath d='M2 32 14 10l7 12 5-8 12 18z' fill='%23FF5B2E'/%3E%3Cpath d='M2 32 14 10l4.5 7.7L9 32z' fill='%23F0A94B'/%3E%3C/svg%3E">
</head>
<body>
  <DestinationMajorPreview race={cascade} />
  <script type="module">
    import { initDestinationMajorInteractions } from '../../shared/utils/destination-major-interactions.js';
    initDestinationMajorInteractions();
  </script>
  <Fragment set:html={registerClickListenerScript()} />
</body>
</html>

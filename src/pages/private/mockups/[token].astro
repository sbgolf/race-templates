---
import CommunityPreview from "../../../templates/community/pages/CommunityPreview.astro";
import DestinationMajorPreview from "../../../templates/destination-major/pages/DestinationMajorPreview.astro";
import PerformancePreview from "../../../templates/performance/pages/PerformancePreview.astro";
import { ga4Snippet, registerClickListenerScript } from "../../../shared/analytics/register-click.mjs";
import { cleanPrivateDisplayCopy, templateForPrivateMockup } from "../../../shared/private-mockup-value.mjs";
import { sportsEventJsonLdScript } from "../../../shared/schema/sports-event-jsonld.mjs";

export function getStaticPaths() {
  const tokenPattern = /^[a-f0-9]{32,}$/i;
  const mockups = import.meta.glob("../../../data/private-mockups/*.json", { eager: true });
  return Object.entries(mockups).flatMap(([file, module]) => {
    const race = module.default;
    const fileSlug = file.split('/').pop().replace(/\.json$/, '');
    const token = race.private_mockup?.access_token;
    const slug = race.private_mockup?.race_slug || fileSlug;

    if (!tokenPattern.test(token || '')) {
      return [];
    }

    return { params: { token, slug }, props: { race } };
  });
}

const { race: rawRace } = Astro.props;
const race = privateDisplayRace(rawRace);
const template = templateForPrivateMockup(race);
const isDestinationMajor = template === 'destination-major';
const isPerformance = template === 'performance';

function privateDisplayRace(race) {
  const copy = typeof structuredClone === 'function'
    ? structuredClone(race)
    : JSON.parse(JSON.stringify(race));

  if (!copy.seo) copy.seo = {};
  copy.seo.meta_description = cleanPrivateDisplayCopy(
    copy.seo.meta_description || `${copy.identity?.name || 'Race'} race website for runners.`
  );
  return cleanPrivateDisplayStrings(copy);
}

function cleanPrivateDisplayStrings(value) {
  if (Array.isArray(value)) return value.map(cleanPrivateDisplayStrings);
  if (value && typeof value === 'object') {
    return Object.fromEntries(Object.entries(value).map(([key, entry]) => [key, cleanPrivateDisplayStrings(entry)]));
  }
  return typeof value === 'string' ? cleanPrivateDisplayCopy(value) : value;
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{race.seo?.meta_title || `${race.identity?.name} — Race Website`}</title>
  <meta name="description" content={race.seo?.meta_description || 'A race website for runners.'}>
  <meta name="robots" content="noindex,nofollow,noarchive,nosnippet">
  <meta name="googlebot" content="noindex,nofollow,noarchive,nosnippet">
  <Fragment set:html={ga4Snippet(race)} />
  <Fragment set:html={sportsEventJsonLdScript(race)} />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Crect width='40' height='40' rx='8' fill='%232A1F18'/%3E%3Cpath d='M10 22 L17 29 L30 11' stroke='%23FAF6EE' stroke-width='3' stroke-linecap='round' stroke-linejoin='round' fill='none'/%3E%3C/svg%3E">
</head>
<body data-private-mockup="true">
  {isDestinationMajor ? <DestinationMajorPreview race={race} /> : isPerformance ? <PerformancePreview race={race} isPrivateMockup={true} galleryAssets={race.private_mockup?.assets || []} /> : <CommunityPreview race={race} />}
  <Fragment set:html={registerClickListenerScript()} />
</body>
</html>

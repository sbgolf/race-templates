---
import CommunityPreview from "../../../templates/community/pages/CommunityPreview.astro";
import "../../../templates/community/styles/community.css";
import { sportsEventJsonLdScript } from "../../../shared/schema/sports-event-jsonld.mjs";

export function getStaticPaths() {
  const mockups = import.meta.glob("../../../data/private-mockups/*.json", { eager: true });
  return Object.entries(mockups).map(([file, module]) => {
    const slug = file.split('/').pop().replace(/\.json$/, '');
    return { params: { slug }, props: { race: module.default } };
  });
}

const { race } = Astro.props;
const sourceUrl = race.private_mockup?.source_url;
const capturedAt = race.private_mockup?.captured_at ? new Date(race.private_mockup.captured_at).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' }) : 'recently';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{race.seo?.meta_title || `${race.identity?.name} — Private StartLine Concept`}</title>
  <meta name="description" content={race.seo?.meta_description || 'Private StartLine race website concept preview.'}>
  <meta name="robots" content="noindex,nofollow,noarchive,nosnippet">
  <meta name="googlebot" content="noindex,nofollow,noarchive,nosnippet">
  <Fragment set:html={sportsEventJsonLdScript(race)} />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Crect width='40' height='40' rx='8' fill='%232A1F18'/%3E%3Cpath d='M10 22 L17 29 L30 11' stroke='%23FAF6EE' stroke-width='3' stroke-linecap='round' stroke-linejoin='round' fill='none'/%3E%3C/svg%3E">
</head>
<body data-private-mockup="true">
  <aside class="private-concept-banner" aria-label="Private concept preview notice">
    <strong>Private StartLine concept preview</strong>
    <span>Noindex/nofollow. For Steve/internal review only — do not send this URL to a prospect until approved.</span>
    {sourceUrl && <a href={sourceUrl} target="_blank" rel="noopener noreferrer nofollow">Source site</a>}
    <small>Captured {capturedAt}</small>
  </aside>
  <CommunityPreview race={race} />
</body>
</html>

{
  "name": "race-templates",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "validate:config": "node scripts/validate-config.mjs",
    "validate:private-mockups": "node scripts/validate-private-mockups.mjs",
    "validate:rendered-private-mockups": "node scripts/validate-rendered-private-mockups.mjs",
    "validate:private-mockup-facts": "node scripts/private-mockup-fact-matrix.mjs",
    "qa:private-mockups": "node scripts/private-mockup-qa-manifest.mjs --capture=auto",
    "qa:private-mockups:manifest": "node scripts/private-mockup-qa-manifest.mjs --no-capture",
    "build:private-qa": "npm run build && npm run qa:private-mockups",
    "test:private-mockup-generator": "node scripts/test-private-mockup-generator.mjs",
    "test:private-mockup-fact-matrix": "node scripts/test-private-mockup-fact-matrix.mjs",
    "test:private-mockup-qa-manifest": "node scripts/test-private-mockup-qa-manifest.mjs",
    "test:performance-layout-guards": "node scripts/test-performance-layout-guards.mjs",
    "launch:check": "node scripts/launch-check.mjs",
    "scaffold:customer": "node scripts/scaffold-customer.mjs",
    "mockup:private": "node scripts/generate-private-mockup.mjs"
  },
  "dependencies": {
    "@fontsource/big-shoulders-display": "^5.2.5",
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/nunito": "^5.2.7",
    "astro": "^6.4.8"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
